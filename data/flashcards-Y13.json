function startQuizCountdown(hardMode){document.getElementById('d-setup').style.display='none';var cdEl=document.getElementById('d-countdown'),numEl=document.getElementById('d-countdown-num');cdEl.style.display='block';var count=3;function tick(){numEl.style.animation='none';void numEl.offsetWidth;numEl.style.animation='cd-pop .35s ease forwards';numEl.textContent=count;if(count===0){numEl.textContent='Go!';setTimeout(function(){cdEl.style.display='none';startQuiz(hardMode);},500);return;}count--;setTimeout(tick,700);}setTimeout(tick,100);}
function startQuiz(hardMode){var all=DATES.filter(function(d){return d.section===currentUnit;});if(!all.length){document.getElementById('d-out').innerHTML='<div class="empty">No dates loaded for these units.</div>';return;}quizHardMode=!!hardMode;var pool=hardMode?all.filter(function(d){var h=getHardDates(d.section);return h.indexOf(d.event)!==-1;}):all;if(dqTypeMode==='type')pool=pool.filter(function(d){return /^[0-9]{4}$/.test(d.date);});if(!pool.length)pool=all;quizPool=shuffle(pool.slice()).slice(0,Math.min(pool.length,15));quizIdx=0;quizOK=0;quizBad=0;quizStreak=0;quizMissed=[];quizHistory=[];quizViewIdx=0;renderQ();}
function renderQ(){if(quizViewIdx<quizIdx){renderHistQ();return;}if(quizIdx>=quizPool.length){showDatesEnd();return;}var item=quizPool[quizIdx],total=quizPool.length,pct=Math.round(quizIdx/total*100);var col=item.section&&UNITS[item.section]?UNITS[item.section].colour:'#555';var strk=quizStreak>=3?'<span style="font-size:.8rem;color:#F0B429;font-weight:600">🔥 '+quizStreak+'</span>':'';var prevBtn=quizHistory.length>0?'<button onclick="quizGoBack()" style="padding:5px 10px;font-size:.78rem;font-weight:600;border:1px solid var(--border2);border-radius:8px;background:var(--surface);color:var(--muted);cursor:pointer;font-family:inherit">← Prev</button>':'<span></span>';var ansHtml;if(dqTypeMode==='type'){ansHtml='<div style="margin-top:.75rem"><input id="quiz-year-input" type="text" inputmode="numeric" placeholder="Type the year and press Enter…" style="width:100%;padding:10px;font-size:1.1rem;font-weight:700;text-align:center;border:1.5px solid var(--border2);border-radius:10px;background:var(--surface);color:var(--text);font-family:inherit" onkeydown="if(event.key===\'Enter\')checkYearAns()"><div class="quiz-fb" id="qfb"></div></div>';}else{var others=[];var usedDates=new Set([item.date]);var pool=shuffle(DATES.filter(function(d){return d.section===currentUnit&&d.event!==item.event;}));for(var oi=0;oi<pool.length&&others.length<3;oi++){if(!usedDates.has(pool[oi].date)){others.push(pool[oi].event);usedDates.add(pool[oi].date);}}while(others.length<3){var fallback=shuffle(DATES.filter(function(d){return d.section===currentUnit&&d.event!==item.event&&others.indexOf(d.event)===-1;}))[0];if(!fallback)break;others.push(fallback.event);}var opts=shuffle([item.event].concat(others));var optsHtml=opts.map(function(o,i){return '<button class="opt" id="opt'+i+'" data-val="'+esc(o)+'" data-correct="'+esc(item.event)+'" onclick="checkAns(this)">'+o+'</button>';}).join('');ansHtml='<div class="opts">'+optsHtml+'</div><div class="quiz-fb" id="qfb"></div>';}
document.getElementById('d-out').innerHTML='<div class="quiz-prog"><div class="quiz-fill" style="width:'+pct+'%;background:'+col+'"></div></div><div class="quiz-hdr"><div style="display:flex;align-items:center;gap:8px">'+prevBtn+'<span class="quiz-hdr-l">Question '+(quizIdx+1)+' of '+total+'</span></div><div class="sc-row">'+strk+'<span class="sc sc-c">✓ '+quizOK+'</span><span class="sc sc-w">✗ '+quizBad+'</span></div></div><div class="quiz-card" style="border-left:4px solid '+col+'"><div class="quiz-date" style="'+(dqTypeMode==='type'?'font-size:1.05rem;font-weight:600;line-height:1.4;margin-bottom:.5rem':'')+'">'+( dqTypeMode==='type'?item.event:item.date)+'</div><div class="quiz-prompt">'+(dqTypeMode==='type'?'What year did this happen?':'What happened in this year?')+'</div>'+ansHtml+'</div><button onclick="datesShowSetup()" style="margin-top:.75rem;width:100%;padding:8px;font-size:.8rem;font-weight:600;border:1px solid var(--border2);border-radius:8px;background:var(--surface);color:var(--muted);cursor:pointer;font-family:inherit">⚙️ Settings</button>';
if(dqTypeMode==='type'){var inp=document.getElementById('quiz-year-input');if(inp)setTimeout(function(){inp.focus();},50);}}
function renderHistQ(){var hist=quizHistory[quizViewIdx],item=hist.item,total=quizPool.length,pct=Math.round(quizViewIdx/total*100);var col=item.section&&UNITS[item.section]?UNITS[item.section].colour:'#555';var prevBtn=quizViewIdx>0?'<button onclick="quizGoBack()" style="padding:5px 10px;font-size:.78rem;font-weight:600;border:1px solid var(--border2);border-radius:8px;background:var(--surface);color:var(--muted);cursor:pointer;font-family:inherit">← Prev</button>':'<span></span>';var nextBtn='<button onclick="quizGoForward()" style="padding:5px 10px;font-size:.78rem;font-weight:600;border:1px solid var(--border2);border-radius:8px;background:var(--surface);color:var(--muted);cursor:pointer;font-family:inherit">Next →</button>';var resultHtml;if(dqTypeMode==='type'){resultHtml='<div style="margin-top:.75rem"><div class="quiz-fb '+(hist.wasCorrect?'fb-c':'fb-w')+'" style="display:block">'+(hist.wasCorrect?'✓ Correct — '+item.date:'✗ Answer was '+item.date)+'</div></div>';}else{var allOpts=hist.allOpts||[item.date];var optsHtml=allOpts.map(function(o){var cls='opt';if(o===item.event)cls+=' show-c';if(!hist.wasCorrect&&o===hist.chosen)cls+=' wrong';return '<button class="'+cls+'" disabled>'+o+'</button>';}).join('');resultHtml='<div class="opts">'+optsHtml+'</div><div class="quiz-fb '+(hist.wasCorrect?'fb-c':'fb-w')+'" style="display:block">'+(hist.wasCorrect?'Correct!':'Not quite — correct answer highlighted.')+'</div>';}
document.getElementById('d-out').innerHTML='<div class="quiz-prog"><div class="quiz-fill" style="width:'+pct+'%;background:'+col+'"></div></div><div class="quiz-hdr"><div style="display:flex;align-items:center;gap:8px">'+prevBtn+'<span class="quiz-hdr-l">Question '+(quizViewIdx+1)+' of '+total+' <span style="font-size:.7rem;color:var(--muted)">(reviewing)</span></span>'+nextBtn+'</div><div class="sc-row"><span class="sc sc-c">✓ '+quizOK+'</span><span class="sc sc-w">✗ '+quizBad+'</span></div></div><div class="quiz-card" style="border-left:4px solid '+col+'">'+(dqTypeMode==='type'?'<div class="quiz-date" style="font-size:1.05rem;font-weight:600;line-height:1.4;margin-bottom:.5rem">'+item.event+'</div>':'<div class="quiz-date">'+item.date+'</div>')+'<div class="quiz-prompt">'+(dqTypeMode==='type'?'What year did this happen?':'What happened in this year?')+'</div>'+resultHtml+'</div><button onclick="datesShowSetup()" style="margin-top:.75rem;width:100%;padding:8px;font-size:.8rem;font-weight:600;border:1px solid var(--border2);border-radius:8px;background:var(--surface);color:var(--muted);cursor:pointer;font-family:inherit">⚙️ Settings</button>';}
function checkAns(btn){var chosen=btn.dataset.val,correct=btn.dataset.correct,item=quizPool[quizIdx];document.querySelectorAll('.opt').forEach(function(b){b.disabled=true;});var fb=document.getElementById('qfb'),wasCorrect=chosen===correct,allOpts=Array.from(document.querySelectorAll('.opt')).map(function(b){return b.dataset.val;});if(wasCorrect){quizOK++;quizStreak++;btn.classList.add('correct');fb.textContent='Correct!';fb.className='quiz-fb fb-c';var hard=getHardDates(item.section).filter(function(e){return e!==item.event;});saveHardDates(item.section,hard);}else{quizBad++;quizStreak=0;quizMissed.push(item);btn.classList.add('wrong');fb.textContent='Not quite — correct answer highlighted.';fb.className='quiz-fb fb-w';document.querySelectorAll('.opt').forEach(function(b){if(b.dataset.val===correct)b.classList.add('show-c');});var hard=getHardDates(item.section);if(hard.indexOf(item.event)===-1)hard.push(item.event);saveHardDates(item.section,hard);}fb.style.display='block';quizHistory.push({item:item,wasCorrect:wasCorrect,chosen:chosen,allOpts:allOpts});setTimeout(function(){quizIdx++;quizViewIdx=quizIdx;renderQ();},1700);}
function checkYearAns(){var inp=document.getElementById('quiz-year-input');if(!inp||inp.disabled)return;var typed=inp.value.trim();if(!typed)return;var item=quizPool[quizIdx],fb=document.getElementById('qfb'),correctDate=item.date;var allYears=[];var yr=correctDate.replace(/[^0-9\-\u2013]/g,'');var parts=yr.split(/[-\u2013]/);if(parts[0]&&parts[0].length>=3){var base=parseInt(parts[0]);if(base>=100&&base<=2099)allYears.push(String(base));if(parts[1]&&parts[1].length===2){var end=parseInt(parts[0].slice(0,-2)+parts[1]);if(end>=100&&end<=2099&&allYears.indexOf(String(end))===-1)allYears.push(String(end));}}if(!allYears.length){fb.textContent='Answer: '+correctDate;fb.className='quiz-fb fb-w';fb.style.display='block';return;}var typedNorm=[typed.replace(/[^0-9]/g,'')];var wasCorrect=typedNorm.some(function(tn){return allYears.some(function(y){return tn===y;});});inp.disabled=true;if(wasCorrect){quizOK++;quizStreak++;fb.textContent='✓ Correct — '+correctDate;fb.className='quiz-fb fb-c';var hard=getHardDates(item.section).filter(function(e){return e!==item.event;});saveHardDates(item.section,hard);}else{quizBad++;quizStreak=0;quizMissed.push(item);fb.textContent='✗ The answer was '+correctDate;fb.className='quiz-fb fb-w';var hard=getHardDates(item.section);if(hard.indexOf(item.event)===-1)hard.push(item.event);saveHardDates(item.section,hard);}fb.style.display='block';quizHistory.push({item:item,wasCorrect:wasCorrect});setTimeout(function(){quizIdx++;quizViewIdx=quizIdx;renderQ();},2000);}
function startQuizMissed(){if(!quizMissed.length)return;quizPool=shuffle(quizMissed.slice());quizIdx=0;quizOK=0;quizBad=0;quizStreak=0;quizMissed=[];quizHistory=[];quizViewIdx=0;renderQ();}
function quizGoBack(){if(quizViewIdx<=0)return;quizViewIdx--;renderQ();}
