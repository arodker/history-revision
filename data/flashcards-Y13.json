<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0">
<script>if(localStorage.getItem('cr_dark')==='1')document.documentElement.classList.add('dark');</script>
<title>Mr Rodker Civil Rights Revision</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}html{font-size:17px}
:root{--c-ok-bg:#EAF3DE;--c-ok-txt:#3B6D11;--c-ok-border:#3B6D11;--c-err-bg:#FCEBEB;--c-err-txt:#A32D2D;--c-err-border:#A32D2D;--bg:#f8f7f4;--surface:#fff;--card:#fafaf8;--border:#e8e7e2;--border2:#ddddd8;--text:#1a1a18;--muted:#6b6b68;--subtle:#eeede8;--tag-bg:#eeede8;--tag-col:#5f5e5a;--input-bg:#fff;--aa:#1B4B8A;--aa-bg:#EEF3FB;--aa-mid:#4A7EC7;--lab:#9B2335;--lab-bg:#FBEEF0;--lab-mid:#C94A5A;--na:#1A6B5A;--na-bg:#E5F5F0;--na-mid:#2A9E80;--wom:#6B3494;--wom-bg:#F3EEF9;--wom-mid:#9B5EC7;}
:root.dark body{--bg:#1a1a1e;--surface:#26262b;--card:#2e2e34;--border:#3a3a42;--border2:#3a3a42;--text:#e8e8e6;--muted:#9a9a96;--subtle:#2e2e34;--tag-bg:#2e2e34;--tag-col:#aaa;--input-bg:#2e2e34;--c-ok-bg:#1a2e1a;--c-ok-txt:#6fcf6f;--c-ok-border:#3d7a3d;--c-err-bg:#2e1a1a;--c-err-txt:#e07070;--c-err-border:#7a3d3d;}
body{font-family:Arial,Helvetica,sans-serif;background:var(--bg);color:var(--text);min-height:100vh;transition:background .2s,color .2s}
input,select{font-size:max(16px,1em)}
input[type=number]::-webkit-inner-spin-button,input[type=number]::-webkit-outer-spin-button{-webkit-appearance:none;margin:0}
.app{max-width:780px;margin:0 auto;padding:1.5rem 1.25rem 4rem}
h1{font-size:1.45rem;font-weight:700;margin-bottom:.2rem}
.subtitle{font-size:.8rem;color:var(--muted);margin-bottom:1.25rem}
.screen{display:none}.screen.active{display:block}
.pick-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:1rem}
.pick-btn{padding:1.2rem 1rem;border:2px solid transparent;border-radius:14px;cursor:pointer;font-family:inherit;font-weight:700;font-size:.9rem;text-align:left;transition:all .15s;line-height:1.35}
.pick-btn .plabel{font-size:.64rem;font-weight:600;opacity:.65;display:block;margin-bottom:.25rem;text-transform:uppercase;letter-spacing:.06em}
.pick-btn .pdesc{font-size:.7rem;font-weight:400;opacity:.7;display:block;margin-top:.3rem;line-height:1.4}
.pb-aa{background:var(--aa-bg);color:var(--aa);border-color:var(--aa-mid)}.pb-aa:hover{background:#dce8f7}
.pb-lab{background:var(--lab-bg);color:var(--lab);border-color:var(--lab-mid)}.pb-lab:hover{background:#f5dee1}
.pb-na{background:var(--na-bg);color:var(--na);border-color:var(--na-mid)}.pb-na:hover{background:#ceeae2}
.pb-wom{background:var(--wom-bg);color:var(--wom);border-color:var(--wom-mid)}.pb-wom:hover{background:#e9dff5}
.mode-header{display:flex;align-items:center;gap:8px;margin-bottom:1.25rem;flex-wrap:wrap}
.back-btn{padding:6px 12px;font-size:.8rem;font-weight:500;border:1px solid var(--border2);border-radius:8px;background:var(--surface);color:var(--muted);cursor:pointer;font-family:inherit}.back-btn:hover{background:var(--subtle)}
.section-badge{font-size:.8rem;font-weight:700;padding:5px 12px;border-radius:20px}
.bg-aa{background:var(--aa-bg);color:var(--aa)}.bg-lab{background:var(--lab-bg);color:var(--lab)}.bg-na{background:var(--na-bg);color:var(--na)}.bg-wom{background:var(--wom-bg);color:var(--wom)}
.mode-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin-bottom:1.25rem}
.mode-btn{padding:.9rem .5rem;border:1.5px solid var(--border2);border-left-width:4px;border-radius:12px;cursor:pointer;font-family:inherit;font-size:.83rem;font-weight:600;text-align:center;background:var(--surface);color:var(--text);transition:all .15s;line-height:1.3}
.mode-btn .icon{font-size:1.3rem;display:block;margin-bottom:.35rem}.mode-btn:hover{border-color:#aaa;background:var(--subtle)}
.btn-go{width:100%;padding:13px;font-size:.95rem;font-weight:700;border:none;border-radius:10px;cursor:pointer;margin-bottom:1.25rem;transition:opacity .15s;color:#fff;font-family:inherit}.btn-go:hover{opacity:.9}
.pill.active-aa{background:var(--aa-bg);color:var(--aa);border-color:var(--aa-mid)}.pill.active-lab{background:var(--lab-bg);color:var(--lab);border-color:var(--lab-mid)}.pill.active-na{background:var(--na-bg);color:var(--na);border-color:var(--na-mid)}.pill.active-wom{background:var(--wom-bg);color:var(--wom);border-color:var(--wom-mid)}
.c-aa{background:var(--aa)}.c-lab{background:var(--lab)}.c-na{background:var(--na)}.c-wom{background:var(--wom)}.c-dark{background:#374151}.c-mixed{background:#3E4651;color:#fff;border:1.5px solid #2D343D}.c-stat{background:#BC5A2A;color:#fff;border:1.5px solid #934323}
.t-ds{background:#F0FDF4;color:#166534}.t-obs{background:#FEE2E2;color:#991b1b}.t-fac{background:#EEF3FB;color:#1B4B8A}.t-tp{background:#FEF9C3;color:#7a5900}
.btn-sm{padding:7px 14px;font-size:.8rem;font-weight:500;border:1px solid var(--border2);border-radius:8px;background:var(--surface);color:var(--text);cursor:pointer;transition:background .12s;font-family:inherit}.btn-sm:hover{background:var(--subtle)}
.filter-row{display:flex;gap:8px;margin-bottom:.9rem;flex-wrap:wrap}
select{padding:8px 10px;font-size:.82rem;border:1px solid var(--border2);border-radius:8px;background:var(--input-bg);color:var(--text);cursor:pointer;flex:1;min-width:140px;font-family:inherit}
.card{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:1.25rem;margin-bottom:.75rem;position:relative;overflow:hidden}
.stripe{position:absolute;left:0;top:0;bottom:0;width:4px}
.s-aa{background:var(--aa-mid)}.s-lab{background:var(--lab-mid)}.s-na{background:var(--na-mid)}.s-wom{background:var(--wom-mid)}
.inner{padding-left:.5rem}
.meta{display:flex;flex-wrap:wrap;gap:5px;margin-bottom:.6rem;align-items:center}
.tag{font-size:.7rem;font-weight:600;padding:3px 9px;border-radius:20px}
.t-grey{background:var(--tag-bg);color:var(--tag-col)}.t-aa{background:var(--aa-bg);color:var(--aa)}.t-lab{background:var(--lab-bg);color:var(--lab)}.t-na{background:var(--na-bg);color:var(--na)}.t-wom{background:var(--wom-bg);color:var(--wom)}
.t-tp{background:#FEF9C3;color:#7a5900}.t-ds{background:#F0FDF4;color:#166534}
.card-heading{font-size:1.05rem;font-weight:700;margin-bottom:.5rem;line-height:1.3;text-decoration:underline;text-underline-offset:3px}
.kc-summary{font-size:.86rem;font-style:italic;color:var(--muted);margin-bottom:.75rem;line-height:1.6}
.factor-key{font-size:.7rem;color:var(--muted);background:var(--subtle);border-radius:7px;padding:.4rem .65rem;margin-bottom:.75rem;line-height:1.6}
.card ul{padding-left:1.2rem;margin:0}.card li{font-size:.86rem;line-height:1.6;margin-bottom:.55rem}.card li:last-child{margin-bottom:0}
.kc-sub{font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--muted);margin:1rem 0 .35rem;padding-bottom:.2rem;border-bottom:1px solid var(--subtle)}.kc-sub:first-child{margin-top:.25rem}.kc-group{font-size:.8rem;font-weight:700;color:var(--text);margin:1.1rem 0 .1rem;padding-bottom:.3rem;border-bottom:2px solid var(--border)}.kc-group:first-child{margin-top:.35rem}.kc-sublabel{font-size:.65rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--muted);margin:.6rem 0 .25rem;padding-left:.1rem}
.btn-row{display:flex;gap:8px;flex-wrap:wrap;margin-top:.9rem}
.empty{padding:2rem;text-align:center;color:var(--muted);font-size:.85rem;border:1px dashed var(--border2);border-radius:12px}
.quiz-prog{height:4px;background:var(--subtle);border-radius:2px;margin-bottom:1rem;overflow:hidden}.quiz-fill{height:100%;border-radius:2px;transition:width .3s}
.quiz-hdr{display:flex;justify-content:space-between;align-items:center;margin-bottom:.75rem}.quiz-hdr-l{font-size:.8rem;color:var(--muted)}
.sc-row{display:flex;gap:6px}.sc{font-size:.8rem;font-weight:600;padding:4px 10px;border-radius:20px}.sc-c{background:var(--c-ok-bg);color:var(--c-ok-txt)}.sc-w{background:var(--c-err-bg);color:var(--c-err-txt)}
.quiz-card{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:1.5rem;margin-bottom:.75rem}
.quiz-fb{font-size:.85rem;font-weight:600;padding:8px;border-radius:8px;margin-top:.75rem;display:none;text-align:center}.fb-c{background:var(--c-ok-bg);color:var(--c-ok-txt)}.fb-w{background:var(--c-err-bg);color:var(--c-err-txt)}
.quiz-date{font-size:1.3rem;font-weight:800;text-align:center;margin-bottom:.5rem;letter-spacing:.01em}
.quiz-prompt{font-size:.82rem;color:var(--muted);text-align:center;margin-bottom:.75rem}
.opts{display:flex;flex-direction:column;gap:8px}
.opt{padding:10px 14px;font-size:.9rem;font-weight:600;text-align:left;border:1.5px solid var(--border2);border-radius:10px;background:var(--surface);color:var(--text);cursor:pointer;font-family:inherit;transition:border-color .1s}
.opt:hover:not(:disabled){border-color:var(--muted)}
.opt.correct{background:var(--c-ok-bg);border-color:var(--c-ok-border);color:var(--c-ok-txt)}
.opt.wrong{background:var(--c-err-bg);border-color:var(--c-err-border);color:var(--c-err-txt)}
.opt.show-c{background:var(--c-ok-bg);border-color:var(--c-ok-border);color:var(--c-ok-txt)}
.opt:disabled{cursor:default}
.end-score{font-size:3.5rem;font-weight:800}.end-sub{font-size:.9rem;color:var(--muted);margin:.3rem 0 1.2rem}
.end-grade{font-size:.9rem;font-weight:600;padding:8px 20px;border-radius:20px;display:inline-block;margin-bottom:1.2rem}.grade-a{background:var(--c-ok-bg);color:var(--c-ok-txt)}.grade-b{background:#FAEEDA;color:#854F0B}.grade-c{background:var(--c-err-bg);color:var(--c-err-txt)}
@keyframes cd-pop{0%{transform:scale(.7);opacity:0}40%{transform:scale(1.15)}70%{transform:scale(.95)}100%{transform:scale(1);opacity:1}}
.nf-badge{position:absolute;top:-9px;right:12px;font-size:.6rem;font-weight:800;letter-spacing:.05em;text-transform:uppercase;background:#FACC15;color:#1a1a18;padding:3px 9px;border-radius:20px;box-shadow:0 2px 6px rgba(0,0,0,.2);animation:nf-pulse 2s ease-in-out infinite}
@keyframes nf-pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.08)}}
.stat-blank{display:inline-block;min-width:74px;text-align:center;font-weight:800;color:var(--muted);border-bottom:2.5px dashed var(--border2);padding:0 6px;margin:0 2px}
.stat-blank.filled{color:var(--c-ok-txt);border-bottom-style:solid;border-bottom-color:var(--c-ok-border)}
.stat-blank.filled-w{color:var(--c-err-txt);border-bottom-style:solid;border-bottom-color:var(--c-err-border)}
.stat-sentence{font-size:1.05rem;font-weight:600;line-height:1.7;margin-bottom:1rem}
.stat-debate{font-size:.72rem;font-weight:700;color:var(--muted);margin-bottom:.6rem;line-height:1.4}
.fd-wheel{width:56px;height:56px;display:block}.fd-wheel-cell{display:flex;flex-direction:column;align-items:center;cursor:pointer;gap:.25rem}
.fd-wheel-label{font-size:.62rem;font-weight:600;color:var(--muted);text-align:center;max-width:60px}
.fd-hints-toggle{display:flex;align-items:center;gap:.5rem;margin-bottom:.75rem;font-size:.8rem;color:var(--muted)}.fd-hints-toggle input{width:16px;height:16px;cursor:pointer}
.fd-scene{perspective:1200px;margin-bottom:.75rem;cursor:pointer}
.fd-card-inner{position:relative;width:100%;transform-style:preserve-3d;transition:transform .45s cubic-bezier(.4,0,.2,1)}.fd-card-inner.flipped{transform:rotateY(180deg)}
.fd-front,.fd-back{width:100%;min-height:180px;backface-visibility:hidden;-webkit-backface-visibility:hidden;background:var(--card);border:1.5px solid var(--border);border-left-width:4px;border-radius:14px;padding:1.25rem 1.25rem 1rem;box-sizing:border-box}
.fd-back{position:absolute;top:0;left:0;transform:rotateY(180deg)}
.fd-tag{font-size:.7rem;font-weight:600;padding:3px 9px;border-radius:20px;display:inline-block;margin-bottom:.75rem}
.fd-question{font-size:1rem;font-weight:700;line-height:1.45;margin-bottom:.75rem}.fd-hint-chips{display:none;flex-wrap:wrap;gap:5px;margin-bottom:.5rem}
.fd-tap-hint{font-size:.76rem;color:var(--muted);text-align:center;margin-top:.5rem}
.fd-points{padding-left:1.1rem;margin-top:.25rem}.fd-points li{font-size:.87rem;line-height:1.65;margin-bottom:.5rem;opacity:0;transition:opacity .3s}.fd-points li.fd-pt-show{opacity:1}
.fd-btn-row{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:.5rem}
.fd-btn{padding:14px 8px;border-radius:12px;border:none;font-family:inherit;font-size:.95rem;font-weight:700;cursor:pointer;transition:all .15s}
.fd-got{background:#d1fae5;color:#065f46}.fd-got:hover{background:#a7f3d0}.fd-miss{background:#fee2e2;color:#991b1b}.fd-miss:hover{background:#fecaca}
.fd-progress-wrap{margin-bottom:.75rem}.fd-progress-text{font-size:.75rem;color:var(--muted);margin-bottom:4px;display:flex;justify-content:space-between}
.fd-bar-bg{background:var(--subtle);border-radius:99px;height:6px}.fd-bar-fill{height:6px;border-radius:99px;transition:width .3s}
.fd-summary-card{background:var(--card);border:1.5px solid var(--border);border-radius:14px;padding:1.25rem;margin-bottom:1rem;text-align:center}
.fd-summary-row{display:flex;justify-content:space-around;margin:.75rem 0}.fd-summary-stat{font-size:2.5rem;font-weight:800}
.fd-badge-got{background:var(--c-ok-bg);color:var(--c-ok-txt);font-size:.75rem;font-weight:600;padding:3px 10px;border-radius:20px;display:inline-block}
.fd-badge-miss{background:var(--c-err-bg);color:var(--c-err-txt);font-size:.75rem;font-weight:600;padding:3px 10px;border-radius:20px;display:inline-block}
.fd-outstanding-note{font-size:.78rem;color:var(--muted);margin-top:.5rem;padding:.5rem .75rem;background:var(--subtle);border-radius:8px}
.fd-outstanding-banner{font-size:.78rem;color:var(--muted);background:var(--subtle);border-radius:8px;padding:.6rem .75rem;margin-bottom:.75rem;display:none}
@keyframes sout-r{to{transform:translateX(110%);opacity:0}}@keyframes sout-l{to{transform:translateX(-110%);opacity:0}}
@keyframes sin-r{from{transform:translateX(110%);opacity:0}}@keyframes sin-l{from{transform:translateX(-110%);opacity:0}}
.slide-out-right{animation:sout-r .2s ease forwards}.slide-out-left{animation:sout-l .2s ease forwards}
.slide-in-r{animation:sin-r .25s ease forwards}.slide-in-l{animation:sin-l .25s ease forwards}
.rf-section-label{font-size:.72rem;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;margin-bottom:.6rem}
.rf-pills{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:.9rem}
.rf-pill{padding:6px 12px;font-size:.78rem;font-weight:600;border:1.5px solid var(--border2);border-radius:20px;cursor:pointer;background:var(--surface);color:var(--muted);font-family:inherit;transition:all .15s}
.pill{padding:6px 13px;font-size:.78rem;font-weight:600;border:1.5px solid var(--border2);border-radius:20px;cursor:pointer;background:var(--surface);color:var(--muted);font-family:inherit;transition:all .15s}
.active-ds{background:#FEF3DC;color:#7a4e00;border-color:#C47B1A}
.on-aa{background:var(--aa-bg);color:var(--aa);border-color:var(--aa-mid)}.on-lab{background:var(--lab-bg);color:var(--lab);border-color:var(--lab-mid)}.on-na{background:var(--na-bg);color:var(--na);border-color:var(--na-mid)}.on-wom{background:var(--wom-bg);color:var(--wom);border-color:var(--wom-mid)}
.on-ds{background:#FBEFCF;color:#7A4E00;border-color:#C8912A}:root.dark .on-ds{background:#3A2E12;color:#E6C77E;border-color:#9A6B1E}
.count-row{display:flex;gap:8px;margin-bottom:1rem}.count-btn{flex:1;padding:10px;font-size:.9rem;font-weight:700;border:1.5px solid var(--border2);border-radius:10px;cursor:pointer;background:var(--surface);color:var(--text);font-family:inherit;text-align:center;transition:all .15s}.count-btn:hover{border-color:#aaa;background:var(--subtle)}.count-btn.sel{background:#555;color:#fff;border-color:#555}
.rq-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:1rem}
.rq-card{background:var(--card);border:1.5px solid var(--border);border-radius:12px;padding:.85rem;cursor:pointer;min-height:90px;display:flex;flex-direction:column;justify-content:space-between;transition:border-color .15s}.rq-card:hover{border-color:var(--muted)}.rq-card.revealed{border-color:var(--c-ok-border)}
.rq-q{font-size:.88rem;line-height:1.5;color:var(--text);font-weight:500}
.rq-a{display:none;margin-top:.55rem;padding:.45rem .55rem;background:var(--c-ok-bg);border-radius:7px;font-size:.85rem;font-weight:700;color:var(--c-ok-txt);line-height:1.4}.rq-card.revealed .rq-a{display:block}
.rq-tap{font-size:.68rem;color:#bbb;margin-top:.4rem}.rq-btn-row{display:flex;gap:8px;flex-wrap:wrap}
.exam-route-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:1.25rem}
.exam-route-btn{padding:1.3rem 1rem;border:1.5px solid var(--border2);border-radius:12px;cursor:pointer;font-family:inherit;font-size:.85rem;font-weight:700;text-align:left;background:var(--surface);color:var(--text);transition:all .15s;line-height:1.4}.exam-route-btn .er-label{font-size:.67rem;font-weight:600;text-transform:uppercase;letter-spacing:.05em;display:block;margin-bottom:.3rem;opacity:.55}.exam-route-btn:hover{border-color:#aaa;background:var(--subtle)}.exam-route-btn.interp-btn{border-color:#C47B1A;color:#7a4e00}
.essay-card{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:1.25rem;margin-bottom:.75rem}
.essay-q{font-size:1.05rem;font-weight:700;line-height:1.45;margin-bottom:.6rem}.essay-meta{font-size:.74rem;color:var(--muted);margin-bottom:.75rem}
.essay-struct{border-radius:8px;padding:.85rem 1rem;margin-top:.75rem;display:none}.essay-struct.open{display:block}
.essay-struct-title{font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;margin-bottom:.6rem}
.essay-struct table{width:100%;border-collapse:collapse;font-size:.8rem}.essay-struct td{padding:.35rem .5rem;border-bottom:1px solid rgba(0,0,0,.07);vertical-align:top}.essay-struct td:first-child{font-weight:700;white-space:nowrap;padding-right:.75rem}.essay-struct tr:last-child td{border-bottom:none}
.passage-card{background:var(--card);border:1px solid var(--border);border-radius:14px;overflow:hidden;margin-bottom:.75rem}
.passage-hdr{padding:1rem 1.25rem;border-bottom:1px solid var(--border);background:var(--subtle)}.passage-q{font-size:1rem;font-weight:700;line-height:1.4;margin-bottom:.3rem}.passage-meta{font-size:.74rem;color:var(--muted)}.passage-body{padding:1rem 1.25rem}
.passage-item{border:1px solid var(--border);border-radius:9px;padding:.85rem 1rem;margin-bottom:.75rem;background:var(--surface)}.passage-item-hdr{font-size:.76rem;font-weight:700;margin-bottom:.2rem}.passage-item-attr{font-size:.72rem;color:var(--muted);font-style:italic;margin-bottom:.55rem}.passage-item-text{font-size:.82rem;line-height:1.75}
.approach-box{background:var(--subtle);border:1px solid var(--border);border-radius:9px;padding:.85rem 1rem;margin-top:.75rem;display:none}.approach-box.open{display:block}
.approach-title{font-size:.68rem;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;margin-bottom:.5rem}
.approach-list{list-style:none;padding:0}.approach-list li{font-size:.8rem;line-height:1.6;padding:.25rem 0;border-bottom:1px solid var(--border);display:flex;gap:.5rem}.approach-list li:last-child{border-bottom:none}.approach-list li::before{content:'> ';color:var(--muted);flex-shrink:0;font-weight:700}
/* ── SEARCH ── */
#search-btn{padding:6px 10px;font-size:.85rem;border:1px solid var(--border2);border-radius:8px;background:var(--surface);color:var(--muted);cursor:pointer;font-family:inherit}
#search-btn:hover{background:var(--subtle);color:var(--text)}
.search-overlay{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:1000;display:none;align-items:flex-start;justify-content:center;padding:5vh 1rem 1rem;overflow-y:auto}
.search-overlay.open{display:flex}
:root.dark .search-overlay{background:rgba(0,0,0,.7)}
.search-panel{background:var(--surface);border:1px solid var(--border);border-radius:14px;width:100%;max-width:560px;box-shadow:0 12px 32px rgba(0,0,0,.18);overflow:hidden;animation:search-slide .18s ease}
@keyframes search-slide{from{transform:translateY(-12px);opacity:0}to{transform:translateY(0);opacity:1}}
.search-head{display:flex;align-items:center;gap:8px;padding:.8rem 1rem;border-bottom:1px solid var(--border)}
.search-input{flex:1;padding:8px 12px;font-size:.95rem;border:1.5px solid var(--border2);border-radius:8px;background:var(--input-bg);color:var(--text);font-family:inherit;outline:none}
.search-input:focus{border-color:#888}
.search-close{padding:6px 10px;font-size:1rem;border:1px solid var(--border2);border-radius:8px;background:var(--surface);color:var(--muted);cursor:pointer;font-family:inherit;line-height:1}
.search-close:hover{background:var(--subtle)}
.search-hint{padding:.6rem 1rem;font-size:.72rem;color:var(--muted);border-bottom:1px solid var(--border);background:var(--card)}
.search-results{max-height:60vh;overflow-y:auto;padding:.4rem}
.search-empty{padding:1.25rem 1rem;text-align:center;font-size:.85rem;color:var(--muted)}
.search-count{padding:.5rem .75rem .3rem;font-size:.68rem;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.06em}
.search-result{padding:.7rem .85rem;border-radius:10px;cursor:pointer;border:1px solid transparent;margin-bottom:4px;transition:background .12s,border-color .12s}
.search-result:hover{background:var(--subtle);border-color:var(--border2)}
.search-result-meta{display:flex;flex-wrap:wrap;gap:5px;margin-bottom:.35rem;align-items:center}
.search-result-heading{font-size:.92rem;font-weight:600;line-height:1.35;margin-bottom:.25rem;color:var(--text)}
.search-result-snippet{font-size:.78rem;color:var(--muted);line-height:1.5}
.search-result-snippet mark{background:#fff3a8;color:inherit;padding:0 2px;border-radius:2px;font-weight:600}
:root.dark .search-result-snippet mark{background:#7a6500;color:#fff}
.search-result-where{font-size:.66rem;color:var(--muted);font-style:italic;margin-top:.25rem;opacity:.85}
/* ── INLINE SEARCH BAR (on s-pick) ── */
.inline-search-wrap{margin:1.1rem 0}
.inline-search-bar{display:flex;align-items:center;gap:8px;padding:.55rem .8rem;background:var(--surface);border:1.5px solid var(--border2);border-radius:12px;transition:border-color .15s,box-shadow .15s}
.inline-search-bar:focus-within{border-color:#888;box-shadow:0 0 0 3px rgba(120,120,120,.08)}
.inline-search-icon{font-size:1.05rem;opacity:.55;flex-shrink:0}
#inline-search-input{flex:1;border:none;outline:none;background:transparent;color:var(--text);font-size:.95rem;font-family:inherit;padding:8px 0;min-width:0}
#inline-search-input::placeholder{color:var(--muted)}
.inline-search-clear{display:none;background:none;border:none;color:var(--muted);font-size:1.3rem;cursor:pointer;padding:0 6px;line-height:1;font-family:inherit}
.inline-search-clear:hover{color:var(--text)}
.inline-search-clear.show{display:inline-block}
.inline-search-results{margin-top:.6rem}
.inline-search-results:empty{display:none}
.inline-search-results .search-result{background:var(--card);border:1px solid var(--border)}
.inline-search-results .search-count{padding-top:.3rem}
</style>
</head>
<body>
<div class="app">
<div style="display:flex;justify-content:flex-end;align-items:center;gap:6px;margin-bottom:.5rem">
  <button id="search-btn" onclick="openSearch()" title="Search topics">🔍</button>
  <button id="dark-toggle" onclick="toggleDark()" style="padding:6px 10px;font-size:.85rem;border:1px solid var(--border2);border-radius:8px;background:var(--surface);color:var(--muted);cursor:pointer;font-family:inherit">🌙</button>
</div>

<!-- SEARCH OVERLAY -->
<div class="search-overlay" id="search-overlay" onclick="if(event.target===this)closeSearch()">
  <div class="search-panel">
    <div class="search-head">
      <input type="text" class="search-input" id="search-input" placeholder="Search topics, people, events..." autocomplete="off" oninput="runSearch()" onkeydown="searchKeyHandler(event)">
      <button class="search-close" onclick="closeSearch()" title="Close">×</button>
    </div>
    <div class="search-hint">Try: <em>Wounded Knee</em>, <em>Triangle Shirtwaist</em>, <em>Brown v Board</em>, <em>Roe v Wade</em></div>
    <div class="search-results" id="search-results">
      <div class="search-empty">Start typing to search all four units.</div>
    </div>
  </div>
</div>
<div class="screen active" id="s-pick">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:.75rem">
    <h1 style="margin-bottom:0">Civil Rights in the USA</h1>
    <a href="index.html" style="font-size:.78rem;font-weight:600;padding:6px 12px;border:1px solid var(--border2);border-radius:8px;background:var(--surface);color:var(--muted);text-decoration:none;flex-shrink:0">← Hub</a>
  </div>
  <p class="subtitle">Y319 1865-1992 - Select a unit</p>
  <div class="pick-grid">
    <button class="pick-btn pb-aa" onclick="pickUnit('aa')"><span class="plabel">Unit 1</span>✊ African American Rights</button>
    <button class="pick-btn pb-lab" onclick="pickUnit('lab')"><span class="plabel">Unit 2</span>🔨 Labour and Trade Union Rights</button>
    <button class="pick-btn pb-na" onclick="pickUnit('na')"><span class="plabel">Unit 3</span>🏹 Native American Rights</button>
    <button class="pick-btn pb-wom" onclick="pickUnit('wom')"><span class="plabel">Unit 4</span>📢 Women's Rights</button>
  </div>
  <!-- Inline search bar -->
  <div class="inline-search-wrap">
    <div class="inline-search-bar">
      <span class="inline-search-icon">🔍</span>
      <input type="text" id="inline-search-input" placeholder="Search any topic, person or event…" autocomplete="off" oninput="runInlineSearch()" onkeydown="inlineSearchKey(event)">
      <button class="inline-search-clear" id="inline-search-clear" onclick="clearInlineSearch()" title="Clear">×</button>
    </div>
    <div class="inline-search-results" id="inline-search-results"></div>
  </div>
  <div style="margin-top:1.1rem;padding-top:1.1rem;border-top:1px solid var(--border)">
    <div style="display:flex;gap:8px;margin-bottom:1rem">
      <button class="btn-go c-mixed" style="flex:1;margin-bottom:0" onclick="showRapidSetup()">🎯 Mixed Retrieval Quiz</button>
      <button class="btn-go c-stat" style="flex:1;margin-bottom:0;position:relative" onclick="showStatSetup()"><span class="nf-badge">New</span>📊 Depth Study Stat Attack</button>
    </div>
    <p style="font-size:.68rem;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;margin-bottom:.6rem">⚡ Your progress today</p>
    <div style="display:flex;justify-content:space-around;align-items:flex-start;padding:.75rem .5rem;background:var(--surface);border:1.5px solid var(--border);border-radius:14px">
      <div class="fd-wheel-cell" onclick="fdWheelLaunch('aa')"><svg class="fd-wheel" viewBox="0 0 60 60"><circle cx="30" cy="30" r="24" fill="none" stroke="var(--subtle)" stroke-width="6"/><circle class="fd-ring-miss-aa" cx="30" cy="30" r="24" fill="none" stroke="#e5e5e5" stroke-width="6" stroke-dasharray="0 150.8" stroke-linecap="round" transform="rotate(-90 30 30)"/><circle class="fd-ring-got-aa" cx="30" cy="30" r="24" fill="none" stroke="#4A7EC7" stroke-width="6" stroke-dasharray="0 150.8" stroke-linecap="round" transform="rotate(-90 30 30)"/><text x="30" y="34" text-anchor="middle" font-size="10" font-weight="700" fill="var(--text)" class="fd-pct-aa">0%</text></svg><div class="fd-wheel-label">African Am.</div></div>
      <div class="fd-wheel-cell" onclick="fdWheelLaunch('lab')"><svg class="fd-wheel" viewBox="0 0 60 60"><circle cx="30" cy="30" r="24" fill="none" stroke="var(--subtle)" stroke-width="6"/><circle class="fd-ring-miss-lab" cx="30" cy="30" r="24" fill="none" stroke="#e5e5e5" stroke-width="6" stroke-dasharray="0 150.8" stroke-linecap="round" transform="rotate(-90 30 30)"/><circle class="fd-ring-got-lab" cx="30" cy="30" r="24" fill="none" stroke="#C94A5A" stroke-width="6" stroke-dasharray="0 150.8" stroke-linecap="round" transform="rotate(-90 30 30)"/><text x="30" y="34" text-anchor="middle" font-size="10" font-weight="700" fill="var(--text)" class="fd-pct-lab">0%</text></svg><div class="fd-wheel-label">Labour</div></div>
      <div class="fd-wheel-cell" onclick="fdWheelLaunch('na')"><svg class="fd-wheel" viewBox="0 0 60 60"><circle cx="30" cy="30" r="24" fill="none" stroke="var(--subtle)" stroke-width="6"/><circle class="fd-ring-miss-na" cx="30" cy="30" r="24" fill="none" stroke="#e5e5e5" stroke-width="6" stroke-dasharray="0 150.8" stroke-linecap="round" transform="rotate(-90 30 30)"/><circle class="fd-ring-got-na" cx="30" cy="30" r="24" fill="none" stroke="#2A9E80" stroke-width="6" stroke-dasharray="0 150.8" stroke-linecap="round" transform="rotate(-90 30 30)"/><text x="30" y="34" text-anchor="middle" font-size="10" font-weight="700" fill="var(--text)" class="fd-pct-na">0%</text></svg><div class="fd-wheel-label">Native Am.</div></div>
      <div class="fd-wheel-cell" onclick="fdWheelLaunch('wom')"><svg class="fd-wheel" viewBox="0 0 60 60"><circle cx="30" cy="30" r="24" fill="none" stroke="var(--subtle)" stroke-width="6"/><circle class="fd-ring-miss-wom" cx="30" cy="30" r="24" fill="none" stroke="#e5e5e5" stroke-width="6" stroke-dasharray="0 150.8" stroke-linecap="round" transform="rotate(-90 30 30)"/><circle class="fd-ring-got-wom" cx="30" cy="30" r="24" fill="none" stroke="#9B5EC7" stroke-width="6" stroke-dasharray="0 150.8" stroke-linecap="round" transform="rotate(-90 30 30)"/><text x="30" y="34" text-anchor="middle" font-size="10" font-weight="700" fill="var(--text)" class="fd-pct-wom">0%</text></svg><div class="fd-wheel-label">Women</div></div>
    </div>
  </div>
</div>
<div class="screen" id="s-hub">
  <div class="mode-header"><button class="back-btn" onclick="showScreen('s-pick')">🏠 Home</button><span class="section-badge" id="hub-badge"></span></div>
  <button id="hub-pinned-btn" onclick="enterMode('flashcard');setTimeout(fdStartPinned,100)" style="display:none;width:100%;padding:10px;font-size:.85rem;font-weight:600;border:1.5px solid var(--border2);border-radius:10px;background:var(--surface);color:var(--muted);cursor:pointer;font-family:inherit;margin-bottom:1rem">📌 Review pinned cards</button>
  <div style="display:flex;align-items:center;gap:1rem;background:var(--surface);border:1.5px solid var(--border2);border-left-width:4px;border-radius:12px;padding:1rem 1.1rem;margin-bottom:1rem;cursor:pointer" id="fd-primary-btn" onclick="enterMode('flashcard')">
    <div style="flex-shrink:0;text-align:center"><svg id="fd-hub-wheel" viewBox="0 0 60 60" style="width:62px;height:62px;display:block"><circle cx="30" cy="30" r="24" fill="none" stroke="var(--subtle)" stroke-width="6"/><circle id="fd-hub-ring-miss" cx="30" cy="30" r="24" fill="none" stroke="#e5e5e5" stroke-width="6" stroke-dasharray="0 150.8" stroke-linecap="round" transform="rotate(-90 30 30)"/><circle id="fd-hub-ring-got" cx="30" cy="30" r="24" fill="none" stroke="#888" stroke-width="6" stroke-dasharray="0 150.8" stroke-linecap="round" transform="rotate(-90 30 30)"/><text id="fd-hub-pct" x="30" y="34" text-anchor="middle" font-size="10" font-weight="700" fill="var(--text)">0%</text></svg></div>
    <div style="flex:1"><div style="font-size:1rem;font-weight:700;margin-bottom:.2rem">Flashcard Mode</div><div style="font-size:.75rem;color:var(--muted);line-height:1.4">Test yourself card by card. Missed cards come back until you know them.</div><div style="font-size:.67rem;color:var(--muted);margin-top:.3rem;opacity:.75">Tap to start - wheel shows today's progress</div></div>
  </div>
  <p style="font-size:.68rem;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;margin-bottom:.5rem">Also available</p>
  <div class="mode-grid">
    <button class="mode-btn" id="hub-btn-knowledge" onclick="enterMode('knowledge')"><span class="icon">&#x1F9E0;</span>Revision Guide</button>
    <button class="mode-btn" id="hub-btn-dates" onclick="enterMode('dates')"><span class="icon">📅</span>Key Dates Quiz</button>
    <button class="mode-btn" id="hub-btn-exam" disabled style="opacity:.45;cursor:default;border-left-color:var(--border2)!important"><span class="icon">✏️</span>Exam Practice<br><span style="font-size:.65rem;font-weight:400;opacity:.7">🚧 Coming soon</span></button>
  </div>
</div>
<div class="screen" id="s-main">
  <div class="mode-header"><div style="display:flex;gap:6px"><button class="back-btn" onclick="showScreen('s-hub')">← Back</button><button class="back-btn" onclick="showScreen('s-pick')">🏠 Home</button></div><span class="section-badge" id="main-badge"></span><span id="mode-title" style="font-size:.8rem;font-weight:600;color:var(--muted)"></span></div>
  <div id="mode-knowledge" style="display:none">
    <div class="filter-row"><select id="k-period" onchange="jumpToPeriod()"><option value="">-- select a period --</option></select></div>
    <div class="filter-row" id="k-ds-row" style="display:none"><select id="k-ds" onchange="jumpToDs()"><option value="">-- select a depth study debate --</option></select></div>
    <div class="filter-row" id="k-fac-row" style="display:none"><select id="k-fac" onchange="jumpToFac()"><option value="">-- select a factor --</option></select></div>
    <div class="filter-row" id="k-obs-row" style="display:none"><select id="k-obs" onchange="jumpToObs()"><option value="">-- select an obstacle --</option></select></div>
    <div class="filter-row" id="k-ds-row" style="display:none"><select id="k-ds" onchange="jumpToDs()"><option value="">-- select a depth study debate --</option></select></div>
    <div style="display:flex;gap:8px;margin-bottom:.5rem"><button class="btn-sm" style="flex:1;text-align:center;padding:9px" onclick="stepPeriod(-1)">← Prev</button><button class="btn-sm" style="flex:1;text-align:center;padding:9px" onclick="stepPeriod(1)">Next →</button></div>
    <div id="k-out"><div class="empty">Select a period above to begin.</div></div>
    <div style="display:flex;gap:8px;margin-top:.5rem"><button class="btn-sm" style="flex:1;text-align:center;padding:9px" onclick="stepPeriod(-1)">← Prev</button><button class="btn-sm" style="flex:1;text-align:center;padding:9px" onclick="stepPeriod(1)">Next →</button></div>
  </div>
  <div id="mode-flashcard" style="display:none">
    <div id="fd-setup">
      <p style="font-size:.72rem;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;margin-bottom:.5rem">Filter by period</p>
      <div class="pill-row" id="fd-era-pills"></div>
      <div class="fd-hints-toggle"><input type="checkbox" id="fd-hints-on" onchange="fdSyncHints(this.checked)"><label for="fd-hints-on">💡 Show keyword hints</label></div>
      <div class="fd-outstanding-banner" id="fd-outstanding-banner"></div>
      <button class="btn-go" id="fd-start-btn" onclick="fdStart()">⚡ Start — <span id="fd-start-count">0</span> cards</button>
      <button id="fd-pinned-btn" onclick="fdStartPinned()" style="display:none;background:none;border:1px solid var(--border);border-radius:8px;color:var(--muted);font-size:.78rem;font-weight:600;padding:.35rem .9rem;cursor:pointer;width:100%;text-align:center;margin-top:.5rem">📌 Review pinned cards</button>
      <div style="display:flex;align-items:flex-start;gap:1rem;padding:.75rem .5rem .25rem;margin-top:.75rem">
        <div style="text-align:center;flex-shrink:0"><svg id="fd-setup-wheel" viewBox="0 0 60 60" style="width:62px;height:62px;display:block;margin:0 auto .3rem"><circle cx="30" cy="30" r="24" fill="none" stroke="var(--subtle)" stroke-width="6"/><circle id="fd-setup-ring-miss" cx="30" cy="30" r="24" fill="none" stroke="#e5e5e5" stroke-width="6" stroke-dasharray="0 150.8" stroke-linecap="round" transform="rotate(-90 30 30)"/><circle id="fd-setup-ring-got" cx="30" cy="30" r="24" fill="none" stroke="#888" stroke-width="6" stroke-dasharray="0 150.8" stroke-linecap="round" transform="rotate(-90 30 30)"/><text id="fd-setup-pct" x="30" y="34" text-anchor="middle" font-size="10" font-weight="700" fill="var(--text)">0%</text></svg><div id="fd-setup-label" class="fd-wheel-label"></div></div>
        <div id="fd-unit-breakdown" style="flex:1;font-size:.72rem;margin-top:.1rem"></div>
      </div>
    </div>
    <div id="fd-drill" style="display:none">
      <div class="fd-progress-wrap"><div class="fd-progress-text"><span id="fd-prog-text"></span><span id="fd-prog-count"></span></div><div class="fd-bar-bg"><div class="fd-bar-fill" id="fd-bar" style="width:0%"></div></div></div>
      <div class="fd-hints-toggle" style="margin-bottom:.5rem;margin-top:-.25rem"><input type="checkbox" id="fd-hints-on-drill" onchange="fdSyncHints(this.checked)"><label for="fd-hints-on-drill">💡 Hints</label></div>
      <div class="fd-scene" id="fd-scene" onclick="fdFlip()"><div class="fd-card-inner" id="fd-card-inner"><div class="fd-front" id="fd-front"><div class="fd-tag" id="fd-tag"></div><div class="fd-question" id="fd-question"></div><div class="fd-hint-chips" id="fd-hint-chips"></div><div class="fd-tap-hint">Tap to reveal answer</div></div><div class="fd-back" id="fd-back"><div class="fd-tag" id="fd-tag-back"></div><ul class="fd-points" id="fd-points"></ul></div></div></div>
      <div class="fd-btn-row" id="fd-btn-row" style="display:none"><button class="fd-btn fd-miss" onclick="fdAnswer(false)">Missed</button><button class="fd-btn fd-got" onclick="fdAnswer(true)">Got it</button></div>
    </div>
    <div id="fd-summary" style="display:none">
      <div class="fd-summary-card"><div style="font-size:1.1rem;font-weight:700;margin-bottom:.5rem">Session complete!</div><div class="fd-summary-row"><div><div class="fd-summary-stat" id="fd-sum-got">0</div><div class="fd-badge-got" style="margin-top:.3rem">Got it</div></div><div><div class="fd-summary-stat" id="fd-sum-miss">0</div><div class="fd-badge-miss" style="margin-top:.3rem">Missed</div></div></div><div class="fd-outstanding-note" id="fd-sum-note"></div></div>
      <button class="btn-go" id="fd-drill-again-btn" onclick="fdDrillMissed()" style="margin-bottom:.75rem">Review missed cards</button>
      <button class="btn-go c-dark" onclick="fdFinish()">Finish and return</button>
    </div>
    <div id="fd-complete" style="display:none;text-align:center;padding:2rem 1rem">
      <div style="margin-bottom:.75rem"><svg viewBox="0 0 80 90" width="90" height="100" xmlns="http://www.w3.org/2000/svg"><polygon points="28,48 20,88 35,78 40,90 40,48" fill="#C0392B"/><polygon points="52,48 60,88 45,78 40,90 40,48" fill="#E74C3C"/><circle cx="40" cy="36" r="32" fill="#F39C12"/><circle cx="40" cy="36" r="28" fill="#F1C40F"/><circle cx="40" cy="36" r="24" fill="#F39C12" opacity=".35"/><text x="40" y="43" text-anchor="middle" font-size="24" fill="#fff" font-family="serif">&#x2605;</text></svg></div>
      <div style="font-size:1.3rem;font-weight:800;margin-bottom:.3rem">Unit Complete!</div>
      <div style="font-size:.9rem;font-weight:600;color:#F39C12;margin-bottom:.3rem" id="fd-complete-count"></div>
      <div style="font-size:.82rem;color:var(--muted);margin-bottom:.5rem">Your progress resets automatically tomorrow —<br>come back then for a fresh session.</div>
      <div style="font-size:.82rem;color:var(--muted);margin-bottom:1.5rem">Want to drill again <em>today</em>? Use the button below.</div>
      <button class="btn-go" onclick="fdResetUnit()" style="background:#F39C12;color:#fff;margin-bottom:.65rem">&#x1F504; Reset &amp; drill again today</button>
      <button class="btn-go" onclick="fdFinish()" style="background:#374151;color:#fff">&#x2190; Back to unit picker</button>
    </div>
  </div>
    <div id="mode-dates" style="display:none">
    <!-- Setup -->
    <div id="d-setup">
      <p style="font-size:.8rem;color:var(--muted);margin-bottom:.6rem">Mode</p>
      <div style="display:flex;gap:8px;margin-bottom:1rem">
        <button id="d-mode-pick" class="count-btn sel" onclick="setDatesMode('pick')" style="flex:1">📋 Pick the event</button>
        <button id="d-mode-type" class="count-btn" onclick="setDatesMode('type')" style="flex:1">⌨️ Type the year</button>
      </div>

      <button id="d-go" class="btn-go c-dark" onclick="startQuizCountdown()">📅 Start quiz</button>
      <button id="d-hard-go" class="btn-sm" style="width:100%;margin-top:.5rem;display:none" onclick="startQuizCountdown(true)">📌 Practise hard dates only</button>
    </div>
    <!-- Countdown -->
    <div id="d-countdown" style="display:none;text-align:center;padding:2rem">
      <div id="d-countdown-num" style="font-size:4rem;font-weight:900;line-height:1"></div>
    </div>
    <!-- Quiz output -->
    <div id="d-out"></div>
  </div><div id="mode-exam" style="display:none">
    <div id="exam-pick">
      <p style="font-size:.84rem;color:var(--muted);margin-bottom:.9rem">Choose your practice route:</p>
      <div class="exam-route-grid"><button class="exam-route-btn" id="exam-btn-essay" onclick="showExamRoute('essay')"><span class="er-label">25 marks</span>Thematic Essay</button><button class="exam-route-btn interp-btn" onclick="showExamRoute('interp')"><span class="er-label">30 marks</span>Interpretation Question</button></div>
    </div>
    <div id="exam-essay" style="display:none">
      <div style="display:flex;gap:8px;margin-bottom:1rem;flex-wrap:wrap;align-items:center"><button class="btn-go" id="essay-go-btn" style="margin-bottom:0;flex:1" onclick="drawEssay()">New question</button><button class="btn-sm" onclick="showExamPick()">Back</button></div>
      <div class="filter-row"><select id="essay-type-filter" onchange="drawEssay()"><option value="all">All question types</option><option value="factor">Factor questions</option><option value="turning">Turning point questions</option><option value="fedgov">Federal Government focus</option><option value="hindrance">Hindrance questions</option><option value="progress">Extent of progress</option></select></div>
      <div id="essay-out"><div class="empty">Press New question to begin.</div></div>
    </div>
    <div id="exam-interp" style="display:none">
      <div style="display:flex;gap:8px;margin-bottom:1rem;flex-wrap:wrap;align-items:center"><button class="btn-go" id="interp-go-btn" style="margin-bottom:0;flex:1" onclick="drawInterp()">New question</button><button class="btn-sm" onclick="showExamPick()">Back</button></div>
