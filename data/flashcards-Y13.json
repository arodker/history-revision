function getUnitEras(){return UNIT_ERAS[currentUnit]||UNIT_ERAS.aa;}
var ALL_ERAS=getUnitEras().all;
var ERA_PILL_KEYS=getUnitEras().keys;
var DS_PAIRS=getUnitEras().pairs;
var fdActiveEras=new Set(ALL_ERAS);
var fdAllOn=true;
function rebuildEraUI(){
  var ue=getUnitEras();
  ALL_ERAS=ue.all;ERA_PILL_KEYS=ue.keys;DS_PAIRS=ue.pairs;
  fdActiveEras=new Set(ALL_ERAS);fdAllOn=true;
  var container=document.getElementById('fd-era-pills');
  if(!container)return;
  var u=currentUnit;
  var html='<button class="pill active-'+u+'" id="fd-era-all" onclick="fdToggleEra(\'all\')">All <span id="fd-count-all" style="opacity:.6"></span></button>';
  ERA_PILL_KEYS.forEach(function(era){
    html+='<button class="pill" id="fd-era-'+era+'" onclick="fdToggleEra(\''+era+'\')">'+ue.labels[era]+' <span id="fd-count-'+era+'" style="opacity:.6"></span></button>';
  });
  container.innerHTML=html;
}
function fdToggleEra(era){
  if(era==='all'){fdActiveEras=new Set(ALL_ERAS);fdAllOn=true;}
  else if(fdAllOn){
    fdActiveEras=new Set([era]);
    if(DS_PAIRS[era])fdActiveEras.add(DS_PAIRS[era]);
    fdAllOn=false;
  }
  else{
    var pair=DS_PAIRS[era];
    if(fdActiveEras.has(era)){fdActiveEras.delete(era);if(pair)fdActiveEras.delete(pair);}
    else{fdActiveEras.add(era);if(pair)fdActiveEras.add(pair);}
    if(fdActiveEras.size===0){fdActiveEras=new Set(ALL_ERAS);fdAllOn=true;}
    else if(fdActiveEras.size===ALL_ERAS.length)fdAllOn=true;
  }
  fdUpdateFilterUI();
}
function fdUpdateFilterUI(){
  var u=currentUnit;
  var allEl=document.getElementById('fd-era-all');
  if(allEl)allEl.className='pill'+(fdAllOn?' active-'+u:'');
  ERA_PILL_KEYS.forEach(function(era){
    var el=document.getElementById('fd-era-'+era);
    if(el)el.className='pill'+(!fdAllOn&&fdActiveEras.has(era)?' active-'+u+(era.indexOf('-ds')!==-1?' active-ds':''):'');
  });
  var count=fdFilteredCards().length;
  var sc=document.getElementById('fd-start-count');if(sc)sc.textContent=count;
}
function fdFilteredCards(){
  return FD.filter(function(c){
    if(c.section!==currentUnit)return false;
    var periods=c.periods&&c.periods.length?c.periods:[c.period];
    if(fdAllOn)return true;
    return periods.some(function(p){return fdActiveEras.has(p);});
  });
}
function fdPopulateCounts(){
  var sec=currentUnit;
  var allCount=FD.filter(function(c){return c.section===sec;}).length;
  var allEl=document.getElementById('fd-count-all');if(allEl)allEl.textContent=allCount?'('+allCount+')':'';
  ERA_PILL_KEYS.forEach(function(era){
    var count=FD.filter(function(c){
      if(c.section!==sec)return false;
      var periods=c.periods&&c.periods.length?c.periods:[c.period];
      return periods.indexOf(era)!==-1;
    }).length;
    var el=document.getElementById('fd-count-'+era);if(el)el.textContent=count?'('+count+')':'';
  });
  fdUpdateFilterUI();
}
function fdStart(){if(!FD.length){alert('No flashcards loaded.');return;}var mastered=fdGetMastered();var base=fdFilteredCards();var unitTotal=base.length;base=base.filter(function(c){return!mastered[fdKey(c)];});if(base.length===0&&unitTotal>0){['fd-setup','fd-drill','fd-summary'].forEach(function(id){document.getElementById(id).style.display='none';});document.getElementById('fd-complete').style.display='block';document.getElementById('fd-complete-count').textContent='All '+unitTotal+' card'+(unitTotal!==1?'s':'')+' mastered ✅';return;}if(!base.length){alert('No cards match this selection.');return;}fdOutstanding=fdGetOutstanding().filter(function(k){return FD.find(function(c){return fdKey(c)===k;});});var outCards=fdOutstanding.map(function(k){return FD.find(function(c){return fdKey(c)===k;});}).filter(Boolean).filter(function(c){return c.section!==currentUnit;});var combined=shuffle(base.slice());outCards.forEach(function(oc,i){combined.splice(Math.min((i+1)*6,combined.length),0,oc);});fdDeck=combined;fdMissed=[];fdGot=0;fdMissCount=0;fdTotal=combined.length;document.getElementById('fd-setup').style.display='none';document.getElementById('fd-drill').style.display='block';fdNext();}
