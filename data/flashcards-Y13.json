function boldHints(text,hints){var out=text;(hints||[]).forEach(function(h){var e=h.replace(/[.*+?^${}()|[\]\\]/g,'\\$&');var re=new RegExp('('+e+')','gi');if(re.test(out)){out=out.replace(new RegExp('('+e+')','gi'),'<strong>$1</strong>');}else{h.split(/[\s\/\-]+/).forEach(function(w){if(w.length>=4){var we=w.replace(/[.*+?^${}()|[\]\\]/g,'\\$&');out=out.replace(new RegExp('('+we+')','gi'),'<strong>$1</strong>');}});}});return out;}
function fdSyncHeight(){var inner=document.getElementById('fd-card-inner'),front=document.getElementById('fd-front'),back=document.getElementById('fd-back');if(!inner||!front||!back)return;inner.style.height=Math.max(fdFlipped?back.offsetHeight:front.offsetHeight,140)+'px';}
function fdFlip(){var inner=document.getElementById('fd-card-inner');if(!fdFlipped){fdFlipped=true;inner.classList.add('flipped');var items=document.querySelectorAll('#fd-points li');items.forEach(function(li,i){setTimeout(function(){li.classList.add('fd-pt-show');fdSyncHeight();},300+i*700);});setTimeout(function(){document.getElementById('fd-btn-row').style.display='grid';fdSyncHeight();},300+items.length*700+400);setTimeout(fdSyncHeight,50);}else if(inner.classList.contains('flipped')){inner.classList.remove('flipped');fdFlipped=false;setTimeout(fdSyncHeight,50);}else{inner.classList.add('flipped');fdFlipped=true;setTimeout(fdSyncHeight,50);}}
function fdAnswer(got){var key=fdKey(fdCurrent),mastered=fdGetMastered(),outstanding=fdGetOutstanding();fdRecordCard(fdCurrent.section||currentUnit,got,fdCurrent.isDepthStudy||false);if(got){fdGot++;mastered[key]=true;fdSetMastered(mastered);var idx=outstanding.indexOf(key);if(idx!==-1)outstanding.splice(idx,1);fdSetOutstanding(outstanding);fdOutstanding=outstanding;}else{fdMissCount++;fdMissed.push(fdCurrent);if(outstanding.indexOf(key)===-1)outstanding.push(key);fdSetOutstanding(outstanding);fdOutstanding=outstanding;if(mastered[key]){delete mastered[key];fdSetMastered(mastered);}}document.getElementById('fd-btn-row').style.display='none';var inner=document.getElementById('fd-card-inner');inner.classList.remove('flipped');inner.classList.add(got?'slide-out-right':'slide-out-left');setTimeout(function(){inner.classList.remove('slide-out-right','slide-out-left');fdNext();inner.classList.add(got?'slide-in-r':'slide-in-l');setTimeout(function(){inner.classList.remove('slide-in-r','slide-in-l');},250);renderFdWheels();renderFdHubWheel();renderFdSetupWheel();},220);}
function fdUpdateProgress(){var seen=fdGot+fdMissCount,pct=fdTotal>0?Math.round(seen/fdTotal*100):0;var bar=document.getElementById('fd-bar');bar.style.width=pct+'%';bar.style.background=UNITS[currentUnit].colour;document.getElementById('fd-prog-text').textContent=seen+' of '+fdTotal+' cards';document.getElementById('fd-prog-count').textContent='Got '+fdGot+'  Missed '+fdMissCount;}
function fdShowSummary(){var mastered=fdGetMastered();var unitTotal=fdFilteredCards().length+fdGot+fdMissCount;var allMastered=fdFilteredCards().filter(function(c){return!mastered[fdKey(c)];}).length===0;if(allMastered&&fdMissCount===0){['fd-drill','fd-summary'].forEach(function(id){document.getElementById(id).style.display='none';});document.getElementById('fd-complete').style.display='block';var total=fdFilteredCards().length;document.getElementById('fd-complete-count').textContent='All '+total+' card'+(total!==1?'s':'')+' mastered \u2705';return;}document.getElementById('fd-drill').style.display='none';document.getElementById('fd-summary').style.display='block';document.getElementById('fd-sum-got').textContent=fdGot;document.getElementById('fd-sum-miss').textContent=fdMissCount;var out=fdGetOutstanding();document.getElementById('fd-sum-note').innerHTML=out.length>0?'<strong>'+out.length+' card'+(out.length>1?'s':'')+' missed</strong> - will be woven into future sessions.':'';var drb=document.getElementById('fd-drill-again-btn');drb.style.display=fdMissCount>0?'block':'none';drb.style.background=UNITS[currentUnit].colour;}
function fdDrillMissed(){if(!fdMissed.length)return;fdDeck=shuffle(fdMissed);fdMissed=[];fdGot=0;fdMissCount=0;fdTotal=fdDeck.length;document.getElementById('fd-summary').style.display='none';document.getElementById('fd-drill').style.display='block';fdNext();}
function fdFinish(){fdSetup();showScreen('s-hub');}
function fdResetUnit(){var mastered=fdGetMastered();var base=fdFilteredCards();base.forEach(function(c){delete mastered[fdKey(c)];});fdSetMastered(mastered);document.getElementById('fd-complete').style.display='none';renderFdSetupWheel();fdStart();}
function fdStartPinned(){var out=fdGetOutstanding(),cards=out.map(function(k){return FD.find(function(c){return fdKey(c)===k;});}).filter(Boolean);if(!cards.length){alert('No pinned cards!');return;}fdDeck=shuffle(cards);fdMissed=[];fdGot=0;fdMissCount=0;fdTotal=fdDeck.length;document.getElementById('fd-setup').style.display='none';document.getElementById('fd-drill').style.display='block';fdNext();}
var CIRC=150.8;
function fdWheelDash(got,miss,deckSize){if(!deckSize)return{got:'0 '+CIRC,miss:'0 '+CIRC};var g=Math.min(Math.round(got/deckSize*CIRC),CIRC),m=Math.min(Math.round(miss/deckSize*CIRC),CIRC-g);return{got:g+' '+(CIRC-g),miss:m+' '+(CIRC-m)};}
function renderFdWheels(){var s=fdGetSession();['aa','lab','na','wom'].forEach(function(u){var deckSize=FD.filter(function(c){return c.section===u;}).length;var got=s.got[u]||0,missCount=(s.total[u]||0)-got,pct=deckSize?Math.round(got/deckSize*100):0;var d=fdWheelDash(got,missCount,deckSize);var miss=document.querySelector('.fd-ring-miss-'+u),ring=document.querySelector('.fd-ring-got-'+u),pe=document.querySelector('.fd-pct-'+u);if(miss)miss.setAttribute('stroke-dasharray',d.miss);if(ring)ring.setAttribute('stroke-dasharray',d.got);if(pe)pe.textContent=pct+'%';});}
function renderFdHubWheel(){var deckSize=FD.filter(function(c){return c.section===currentUnit;}).length;var s=fdGetSession(),got=s.got[currentUnit]||0,missCount=(s.total[currentUnit]||0)-got,pct=deckSize?Math.round(got/deckSize*100):0;var d=fdWheelDash(got,missCount,deckSize);var miss=document.getElementById('fd-hub-ring-miss'),ring=document.getElementById('fd-hub-ring-got'),pe=document.getElementById('fd-hub-pct');if(miss)miss.setAttribute('stroke-dasharray',d.miss);if(ring){ring.setAttribute('stroke-dasharray',d.got);ring.setAttribute('stroke',UNITS[currentUnit].colour);}if(pe)pe.textContent=pct+'%';}
function renderFdSetupWheel(){var deckSize=FD.filter(function(c){return c.section===currentUnit;}).length;var s=fdGetSession(),got=s.got[currentUnit]||0,missCount=(s.total[currentUnit]||0)-got,pct=deckSize?Math.round(got/deckSize*100):0;var d=fdWheelDash(got,missCount,deckSize);var miss=document.getElementById('fd-setup-ring-miss'),ring=document.getElementById('fd-setup-ring-got'),pe=document.getElementById('fd-setup-pct'),lbl=document.getElementById('fd-setup-label');if(miss)miss.setAttribute('stroke-dasharray',d.miss);if(ring){ring.setAttribute('stroke-dasharray',d.got);ring.setAttribute('stroke',UNITS[currentUnit].colour);}if(pe)pe.textContent=pct+'%';if(lbl)lbl.textContent=UNITS[currentUnit].short;var bd=document.getElementById('fd-unit-breakdown');if(bd){var dsTotal=FD.filter(function(c){return c.section===currentUnit&&c.isDepthStudy;}).length;var themTotal=FD.filter(function(c){return c.section===currentUnit&&!c.isDepthStudy;}).length;var dsGot=s.ds_got&&s.ds_got[currentUnit]||0;var themGot=s.them_got&&s.them_got[currentUnit]||0;bd.innerHTML='<div style="line-height:2;font-size:.72rem"><div><span style="color:var(--muted)">1865–1992 cards: </span><strong>'+themGot+' / '+themTotal+'</strong></div><div><span style="color:var(--muted)">🔑 Depth Study: </span><strong>'+dsGot+' / '+dsTotal+'</strong></div><div style="margin-top:.2rem;color:var(--muted)">'+got+' correct of '+deckSize+' total today</div></div>';}}
function fdWheelLaunch(unit){pickUnit(unit);enterMode('flashcard');}

/* ===== Depth Study Stat Attack ===== */
function statFilteredPool(){return STATS.filter(function(s){return statUnits.has(s.section)&&statDS.has(s.depthStudy);});}
function statDSAvailable(){var o={};STATS.forEach(function(x){o[x.depthStudy]=1;});return o;}
function updateStatCounter(){var n=statFilteredPool().length,el=document.getElementById('st-counter'),go=document.getElementById('st-go');if(el)el.textContent=n?(n+' figures available — quiz picks up to 15'):'No figures match these filters';if(go){go.disabled=n===0;go.style.opacity=n===0?'.5':'1';go.style.cursor=n===0?'default':'pointer';}}
function showStatSetup(){var avail=statDSAvailable();['aa','lab','na','wom'].forEach(function(u){var el=document.getElementById('stp-'+u);if(el)el.className='rf-pill'+(statUnits.has(u)?' on-'+u:'');});['gilded-age','new-deal','black-power'].forEach(function(d){var el=document.getElementById('stds-'+d);if(!el)return;if(!avail[d]){statDS.delete(d);el.disabled=true;el.style.opacity='.4';el.style.cursor='default';el.title='Coming soon';el.className='rf-pill';}else{el.disabled=false;el.style.opacity='1';el.style.cursor='pointer';el.title='';el.className='rf-pill'+(statDS.has(d)?' on-ds':'');}});setStatMode(statMode);document.getElementById('st-setup').style.display='block';document.getElementById('st-countdown').style.display='none';document.getElementById('st-out').innerHTML='';updateStatCounter();showScreen('s-stat');}
function toggleStatUnit(u){if(statUnits.has(u)){if(statUnits.size>1)statUnits.delete(u);}else statUnits.add(u);var el=document.getElementById('stp-'+u);if(el)el.className='rf-pill'+(statUnits.has(u)?' on-'+u:'');updateStatCounter();}
function toggleStatDS(d){var el=document.getElementById('stds-'+d);if(el&&el.disabled)return;if(statDS.has(d)){if(statDS.size>1)statDS.delete(d);}else statDS.add(d);if(el)el.className='rf-pill'+(statDS.has(d)?' on-ds':'');updateStatCounter();}
function setStatMode(m){statMode=m;['pick','type'].forEach(function(x){var el=document.getElementById('stm-'+x);if(el)el.classList.toggle('sel',x===m);});}
function statNorm(s){return String(s).toLowerCase().trim().replace(/[,$%]/g,'').replace(/\bdr\b\.?/g,'').replace(/\./g,'').replace(/\s+/g,' ').replace(/(\d+(?:\.\d+)?)\s*(m|mn|million)\b/g,function(_,n){return String(Math.round(parseFloat(n)*1e6));}).replace(/(\d+(?:\.\d+)?)\s*(bn|billion)\b/g,function(_,n){return String(Math.round(parseFloat(n)*1e9));}).replace(/(\d+(?:\.\d+)?)\s*(k|thousand)\b/g,function(_,n){return String(Math.round(parseFloat(n)*1e3));}).replace(/\s+/g,' ').trim();}
function statParseNum(a){var pre='',suf='',word='',t=String(a).trim();if(t.charAt(0)==='$'){pre='$';t=t.slice(1);}var wm=t.match(/\s*(billion|million|thousand)$/i);if(wm){word=' '+wm[1].toLowerCase();t=t.slice(0,wm.index).trim();}if(t.slice(-1)==='%'){suf='%';t=t.slice(0,-1);}var comma=t.indexOf(',')!==-1,clean=t.replace(/,/g,'');if(!/^-?\d+(\.\d+)?$/.test(clean))return {ok:false};var dec=(clean.split('.')[1]||'').length;return {ok:true,val:parseFloat(clean),pre:pre,suf:suf,word:word,dec:dec,comma:comma};}
function statFmt(v,p){var s;if(p.dec>0)s=v.toFixed(p.dec);else s=String(Math.round(v));if(p.comma){var parts=s.split('.');parts[0]=Number(parts[0]).toLocaleString('en-US');s=parts.join('.');}else if(p.dec===0&&Math.abs(v)>=1000&&p.word===''){s=Number(s).toLocaleString('en-US');}return p.pre+s+p.word+p.suf;}
function statIsYear(a){return /^(1[5-9]\d{2}|20\d{2})$/.test(String(a).trim());}
function statDisplayAnswer(item){var q=item.prompt;if(q.indexOf('$____')!==-1)return '$'+item.answer;if(q.indexOf('____%')!==-1)return item.answer+'%';return item.answer;}
function statNumDistractors(answer,type){if(type==='year'||statIsYear(answer)){var y=parseInt(String(answer).replace(/[^0-9]/g,''),10),offs=shuffle([-9,-7,-6,-5,-4,-3,-2,2,3,4,5,6,7,9]),out=[],i;for(i=0;i<offs.length&&out.length<6;i++){var c=String(y+offs[i]);if(out.indexOf(c)===-1&&c!==String(y))out.push(c);}return out;}var p=statParseNum(answer);if(!p.ok)return [];var isPct=(type==='percent');function mk(v){if(v<=0)return null;if(isPct&&p.val<=100&&v>100)return null;return statFmt(v,p);}var mults=shuffle([0.4,0.5,0.6,0.67,0.75,0.8,1.2,1.25,1.33,1.5,1.6,2,2.5]),out=[],seen={};seen[statFmt(p.val,p)]=1;function add(v){if(v==null)return;var f=mk(v);if(f!=null&&!seen[f]){seen[f]=1;out.push(f);}}for(var i=0;i<mults.length&&out.length<6;i++){var raw=p.val*mults[i],v;if(p.dec>0){var f=Math.pow(10,p.dec);v=Math.round(raw*f)/f;}else if(p.val>=1000){var mag=Math.pow(10,Math.max(0,Math.floor(Math.log10(raw))-1));v=Math.round(raw/mag)*mag;}else if(p.val>=100){v=Math.round(raw/5)*5;}else{v=Math.round(raw);}add(v);}if(out.length<3){var step=p.dec>0?Math.pow(10,-p.dec):(p.val>=1000?Math.max(1,Math.round(p.val/20)):1);for(var k=1;k<=8&&out.length<5;k++){add(Math.round((p.val+step*k)*1e6)/1e6);add(Math.round((p.val-step*k)*1e6)/1e6);}}return out;}
function statPromptNums(q){var set={},re=/\$?\d[\d,]*(?:\.\d+)?%?(?:\s?(?:million|billion|thousand))?/gi,m;while((m=re.exec(q))){set[statNorm(m[0])]=1;}return set;}
function statBuildOptions(item,pool){var ans=item.answer,opts=[ans],i,seen={};seen[statNorm(ans)]=1;if(item.options&&item.options.length){return shuffle([ans].concat(item.options.slice(0,3)));}if(item.type==='people'){var same=pool.filter(function(p){return p.type==='people'&&p.answer!==ans&&p.depthStudy===item.depthStudy;}).map(function(p){return p.answer;});var any=pool.filter(function(p){return p.type==='people'&&p.answer!==ans;}).map(function(p){return p.answer;});var src=shuffle(same.length>=3?same:any);for(i=0;i<src.length&&opts.length<4;i++){if(!seen[statNorm(src[i])]){seen[statNorm(src[i])]=1;opts.push(src[i]);}}var pad=['Booker T. Washington','W.E.B. Du Bois','Ida B. Wells','Frances Willard','Jane Addams'];for(i=0;i<pad.length&&opts.length<4;i++){if(!seen[statNorm(pad[i])]){seen[statNorm(pad[i])]=1;opts.push(pad[i]);}}return shuffle(opts);}var pn=statPromptNums(item.prompt);var gen=statNumDistractors(ans,item.type);if(item.type!=='year')gen=gen.filter(function(g){return !pn[statNorm(g)];});gen=shuffle(gen);for(i=0;i<gen.length&&opts.length<4;i++){if(!seen[statNorm(gen[i])]){seen[statNorm(gen[i])]=1;opts.push(gen[i]);}}var guard=0,ap=statParseNum(ans);while(opts.length<4&&guard<40){guard++;var extra;if(item.type==='year'){extra=String(parseInt(String(ans).replace(/[^0-9]/g,''),10)+(guard%2?guard+1:-(guard+1)));}else if(ap.ok){var gv=ap.val*(1+guard*0.13);if(item.type==='percent'&&ap.val<=100&&gv>100){gv=ap.val*(1-guard*0.07);}if(gv<=0)continue;extra=statFmt(gv,ap);}else{extra=ans+' ';}if(!seen[statNorm(extra)]&&!(item.type!=='year'&&pn[statNorm(extra)])){seen[statNorm(extra)]=1;opts.push(extra);}}return shuffle(opts.slice(0,4));}
function startStat(){var full=statFilteredPool();if(!full.length){updateStatCounter();return;}stStatFilteredPoolCache=full;stPool=shuffle(full.slice()).slice(0,Math.min(full.length,15));stIdx=0;stOK=0;stBad=0;stStreak=0;stMissed=[];document.getElementById('st-setup').style.display='none';document.getElementById('st-out').innerHTML='';var cd=document.getElementById('st-countdown'),num=document.getElementById('st-countdown-num');cd.style.display='block';var c=3;(function tick(){num.style.animation='none';void num.offsetWidth;num.style.animation='cd-pop .35s ease forwards';num.textContent=c;if(c===0){num.textContent='Go!';setTimeout(function(){cd.style.display='none';renderStat();},480);return;}c--;setTimeout(tick,650);})();}
function renderStat(){if(stIdx>=stPool.length){showStatEnd();return;}var item=stPool[stIdx],total=stPool.length,pct=Math.round(stIdx/total*100);var col=UNITS[item.section]?UNITS[item.section].colour:'#7C3AED';var dsl={'gilded-age':'Gilded Age','new-deal':'New Deal','black-power':'Black Power'}[item.depthStudy]||'';var strk=stStreak>=3?'<span style="font-size:.8rem;color:#F0B429;font-weight:600">\uD83D\uDD25 '+stStreak+'</span>':'';var sentence=esc(item.prompt).replace('____','<span class="stat-blank" id="st-blank">?</span>');var ansHtml;if(statMode==='type'){ansHtml='<div style="margin-top:.25rem"><input id="st-input" type="text" autocomplete="off" placeholder="Type the missing figure and press Enter\u2026" style="width:100%;padding:11px;font-size:1.05rem;font-weight:700;text-align:center;border:1.5px solid var(--border2);border-radius:10px;background:var(--surface);color:var(--text);font-family:inherit" onkeydown="if(event.key===\'Enter\')checkStatType()"><div class="quiz-fb" id="st-fb"></div></div>';}else{var opts=statBuildOptions(item,stStatFilteredPoolCache);ansHtml='<div class="opts">'+opts.map(function(o){return '<button class="opt" data-val="'+esc(o)+'" onclick="checkStatPick(this)">'+esc(o)+'</button>';}).join('')+'</div><div class="quiz-fb" id="st-fb"></div>';}document.getElementById('st-out').innerHTML='<div class="quiz-prog"><div class="quiz-fill" id="st-prog" style="width:'+pct+'%;background:'+col+'"></div></div><div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:.85rem"><span style="font-size:.8rem;color:var(--muted)">Question '+(stIdx+1)+' of '+total+'</span><div class="sc-row">'+strk+'<span class="sc sc-c" id="st-ok">\u2713 '+stOK+'</span><span class="sc sc-w" id="st-bad">\u2717 '+stBad+'</span></div></div><div style="background:var(--card);border:1.5px solid var(--border);border-left:4px solid '+col+';border-radius:12px;padding:1.1rem"><div class="stat-debate"><span class="section-badge bg-'+item.section+'" style="font-size:.62rem;padding:3px 9px">'+esc(dsl)+'</span> &nbsp;'+esc(item.debate)+'</div><div class="stat-sentence">'+sentence+'</div>'+ansHtml+'</div>'+'<button class="btn-sm" onclick="showStatSetup()" style="width:100%;margin-top:.75rem">⚙️ Settings</button>';if(statMode==='type'){var inp=document.getElementById('st-input');if(inp)setTimeout(function(){inp.focus();},60);}}
function checkStatPick(btn){var chosen=btn.dataset.val,item=stPool[stIdx],ans=item.answer;document.querySelectorAll('#st-out .opt').forEach(function(b){b.disabled=true;});var ok=statNorm(chosen)===statNorm(ans);var blank=document.getElementById('st-blank'),fb=document.getElementById('st-fb');blank.textContent=ans;blank.className='stat-blank filled';if(ok){stOK++;stStreak++;btn.classList.add('correct');fb.textContent='Correct!';fb.className='quiz-fb fb-c';}else{stBad++;stStreak=0;stMissed.push(item);btn.classList.add('wrong');document.querySelectorAll('#st-out .opt').forEach(function(b){if(statNorm(b.dataset.val)===statNorm(ans))b.classList.add('show-c');});fb.innerHTML='Not quite \u2014 the answer was <strong>'+esc(statDisplayAnswer(item))+'</strong>';fb.className='quiz-fb fb-w';}fb.style.display='block';setTimeout(function(){stIdx++;renderStat();},1650);}
function checkStatType(){var inp=document.getElementById('st-input');if(!inp||inp.disabled)return;var typed=inp.value.trim();if(!typed)return;var item=stPool[stIdx],ans=item.answer,accepts=[ans].concat(item.accept||[]).map(statNorm),ok=accepts.indexOf(statNorm(typed))!==-1;inp.disabled=true;var blank=document.getElementById('st-blank'),fb=document.getElementById('st-fb');blank.textContent=ans;blank.className='stat-blank filled';if(ok){stOK++;stStreak++;fb.innerHTML='\u2713 Correct \u2014 <strong>'+esc(statDisplayAnswer(item))+'</strong>';fb.className='quiz-fb fb-c';}else{stBad++;stStreak=0;stMissed.push(item);fb.innerHTML='\u2717 The answer was <strong>'+esc(statDisplayAnswer(item))+'</strong>';fb.className='quiz-fb fb-w';}fb.style.display='block';setTimeout(function(){stIdx++;renderStat();},1900);}
function showStatEnd(){var total=stPool.length,pct=total?Math.round(stOK/total*100):0;var msg=pct===100?'Flawless recall! \uD83C\uDFC6':pct>=80?'Excellent \u2014 figures locked in \uD83C\uDFAF':pct>=60?'Solid \u2014 drill the slips \u2B50':pct>=40?'Getting there \u2014 go again \uD83D\uDCDA':'Keep drilling \u2014 precision comes \uD83D\uDCAA';var missed='';if(stMissed.length){missed='<div style="text-align:left;margin-bottom:1.25rem"><div style="font-size:.72rem;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:.5rem">Review these:</div>'+stMissed.map(function(x){var col=UNITS[x.section]?UNITS[x.section].colour:'#7C3AED';return '<div style="background:var(--card);border:1px solid var(--border);border-left:3px solid '+col+';border-radius:8px;padding:.5rem .75rem;margin-bottom:.35rem;font-size:.82rem;line-height:1.55">'+esc(x.prompt).replace('____','<strong style="color:'+col+'">'+esc(x.answer)+'</strong>')+'</div>';}).join('')+'</div>';}document.getElementById('st-out').innerHTML='<div style="padding:1.5rem 0"><div style="text-align:center;margin-bottom:1.25rem"><div style="font-size:3rem;font-weight:900">'+stOK+'/'+total+'</div><div style="font-size:.85rem;color:var(--muted);margin-bottom:.5rem">'+pct+'% correct</div><div style="font-size:.95rem;font-weight:700">'+msg+'</div></div>'+missed+'<div style="display:flex;flex-direction:column;gap:8px"><button class="btn-go c-dark" style="margin-bottom:0" onclick="startStat()">Play again</button>'+(stMissed.length?'<button class="btn-sm" onclick="startStatMissed()">\uD83D\uDD01 Drill the '+stMissed.length+' I missed</button>':'')+'<button class="btn-sm" onclick="showStatSetup()">\u2699\uFE0F Settings</button></div></div>';}
function startStatMissed(){if(!stMissed.length)return;stPool=shuffle(stMissed.slice());stIdx=0;stOK=0;stBad=0;stStreak=0;stMissed=[];document.getElementById('st-setup').style.display='none';document.getElementById('st-countdown').style.display='none';renderStat();}

var KC=[],FD=[],DATES=[],ESSAY_QS=[],INTERP_QS=[];
Promise.all([
  fetch('data/kc-Y13.json').then(function(r){return r.ok?r.json():[];}).catch(function(){return [];}),
  fetch('data/flashcards-Y13.json').then(function(r){return r.ok?r.json():[];}).catch(function(){return [];}),
  fetch('data/rq-Y13.json').then(function(r){return r.ok?r.json():[];}).catch(function(){return [];}),
  fetch('data/dates-Y13.json').then(function(r){return r.ok?r.json():[];}).catch(function(){return [];}),
  fetch('data/essays-Y13.json').then(function(r){return r.ok?r.json():[];}).catch(function(){return [];}),
  fetch('data/interp-Y13.json').then(function(r){return r.ok?r.json():[];}).catch(function(){return [];}),
  fetch('data/stats-Y13.json').then(function(r){return r.ok?r.json():[];}).catch(function(){return [];})
]).then(function(results){
  KC=results[0]; FD=results[1]; RQ=results[2]; DATES=results[3]; ESSAY_QS=results[4]; INTERP_QS=results[5]; STATS=results[6]||[]; updateRQCounter(); applyDatesHardBtn(); updateStatCounter();
  console.log('Data loaded — KC:',KC.length,'FD:',FD.length,'STATS:',STATS.length);
  renderFdWheels(); renderFdSetupWheel(); renderFdHubWheel(); fdPopulateCounts();
  var km=document.getElementById('mode-knowledge');
  if(km&&km.style.display!=='none')buildPeriodDropdown();
}).catch(function(err){console.warn('Data load issue:',err);});

</script>
