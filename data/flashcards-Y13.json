function generateRQ(){var pool=shuffle(RQ.filter(function(q){return rqUnits.has(q.section);}));if(pool.length<1){alert('No questions loaded — check rq-Y13.json is in the data/ folder.');return;}document.getElementById('rq-setup').style.display='none';document.getElementById('rq-out').style.display='none';document.getElementById('rq-one').style.display='none';document.getElementById('rq-endless').style.display='none';
if(rqMode==='batch'){var ten=pool.slice(0,10);document.getElementById('rq-grid').innerHTML=ten.map(function(q,i){return '<div class="rq-card" onclick="this.classList.toggle(\'revealed\')" style="border-left:4px solid '+(UNITS[q.section]?UNITS[q.section].colour:'#888')+'"><div class="rq-q">'+(i+1)+'. '+q.q+'</div><div class="rq-a">'+q.a+'</div><div class="rq-tap">Tap to reveal</div></div>';}).join('');document.getElementById('rq-out').style.display='block';}
