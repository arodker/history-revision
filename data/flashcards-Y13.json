function showDatesEnd(){var pct=Math.round(quizOK/quizPool.length*100),col=UNITS[currentUnit]?UNITS[currentUnit].colour:'#555';var missedHtml='';if(quizMissed.length){missedHtml='<div style="margin-bottom:1.25rem;text-align:left"><div style="font-size:.72rem;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:.5rem">Missed:</div>'+quizMissed.map(function(d){return '<div style="background:var(--card);border:1px solid var(--border);border-left:3px solid '+col+';border-radius:8px;padding:.4rem .75rem;margin-bottom:.3rem;font-size:.82rem"><strong>'+d.date+'</strong> — '+d.event+'</div>';}).join('')+'</div>';}document.getElementById('d-out').innerHTML='<div style="padding:2rem 1rem"><div style="text-align:center;margin-bottom:1.25rem"><div style="font-size:3rem;font-weight:900;margin-bottom:.25rem">'+quizOK+'/'+quizPool.length+'</div><div style="font-size:.85rem;color:var(--muted);margin-bottom:.75rem">'+pct+'% correct</div><div style="font-size:.95rem;font-weight:700;margin-bottom:1rem">'+(pct===100?'Perfect! 🏆':pct>=80?'Excellent 🎯':pct>=60?'Good effort ⭐':pct>=40?'Keep drilling 📚':'Keep going 💪')+'</div></div>'+missedHtml+'<div style="display:flex;flex-direction:column;gap:8px"><button onclick="startQuiz(false)" style="padding:11px;font-size:.95rem;font-weight:700;border:none;border-radius:10px;background:'+col+';color:#fff;cursor:pointer;font-family:inherit">Try again</button>'+(quizMissed.length?'<button onclick="startQuizMissed()" style="padding:11px;font-size:.9rem;font-weight:600;border:1.5px solid '+col+';border-radius:10px;background:var(--surface);color:'+col+';cursor:pointer;font-family:inherit">Drill missed ('+quizMissed.length+')</button>':'')+' <button onclick="datesShowSetup()" style="padding:11px;font-size:.9rem;font-weight:600;border:1.5px solid var(--border2);border-radius:10px;background:var(--surface);color:var(--text);cursor:pointer;font-family:inherit">⚙️ Settings</button></div></div>';}

