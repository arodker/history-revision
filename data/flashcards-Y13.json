function drawEssay(){var f=document.getElementById('essay-type-filter').value,pool=(ESSAY_QS||[]).filter(function(q){return q.section===currentUnit&&(f==='all'||q.type===f);});var out=document.getElementById('essay-out');if(!pool.length){out.innerHTML='<div class="empty">No questions available yet.</div>';return;}var q=rand(pool),uid='eq'+Math.random().toString(36).slice(2,6),u=UNITS[currentUnit],tm={factor:'Factor',turning:'Turning point',fedgov:'Federal Gov',hindrance:'Hindrance',progress:'Extent of progress'};out.innerHTML='<div class="essay-card"><div class="essay-q">'+q.q+'</div><div class="essay-meta">'+(q.year||'')+' - '+(tm[q.type]||q.type||'')+' - 25 marks</div><div class="btn-row"><button class="btn-sm" onclick="drawEssay()">New question</button><button class="btn-sm" id="sb'+uid+'" onclick="tog(\''+uid+'_s\',document.getElementById(\'sb'+uid+'\'),\'Show structure\',\'Hide structure\')">Show structure</button></div><div class="essay-struct" id="'+uid+'_s" style="background:var(--subtle)"><div class="essay-struct-title" style="color:'+u.colour+'">Right-by-Right Structure</div><table><tr><td>Intro</td><td>Deconstruct question. Set criteria. State thesis.</td></tr><tr><td>Para 1</td><td>Political Rights - Yes (evidence) - But (limits) - So (judgement).</td></tr><tr><td>Para 2</td><td>Social Rights - repeat structure.</td></tr><tr><td>Para 3</td><td>Economic Rights - repeat structure.</td></tr><tr><td>Conclusion</td><td>Overall judgement. Return to thesis. Cover 1865-1992.</td></tr></table></div></div>';}
