<script>
var UNITS={aa:{label:'African American Rights',short:'African Americans',colour:'#4A7EC7',cls:'aa',rights:['Political Rights','Social Rights','Economic Rights']},lab:{label:'Labour and Trade Union Rights',short:'Labour',colour:'#C94A5A',cls:'lab',rights:['Right to Organise','Right to Strike','Right to Fair Wages and Conditions']},na:{label:'Native American Rights',short:'Native Americans',colour:'#2A9E80',cls:'na',rights:['Right to Land','Right to Self-Determination','Religious and Cultural Rights']},wom:{label:"Women's Rights",short:'Women',colour:'#9B5EC7',cls:'wom',rights:['Political Rights','Social and Economic Rights','Reproductive and Personal Rights']}};
var currentUnit='aa',KC=[],FD=[],RQ=[],DATES=[],ESSAY_QS=[],INTERP_QS=[],STATS=[],kPeriodIdx=0;
var statUnits=new Set(['aa','lab','na','wom']),statDS=new Set(['gilded-age','new-deal','black-power']),statMode='pick';
var stPool=[],stIdx=0,stOK=0,stBad=0,stStreak=0,stMissed=[],stStatFilteredPoolCache=[];
// RQ state
var rqMode='batch',rqUnits=new Set(['aa','lab','na','wom']);
var rqOnePool=[],rqOneIdx=0,rqOneOK=0,rqOneBad=0,rqOneMissed=[],rqOneStreak=0;
var rqElPool=[],rqElIdx=0,rqElOK=0,rqElBad=0,rqElStreak=0;
// Dates state
var dqUnits=new Set(['aa','lab','na','wom']),dqTypeMode='pick';
var quizPool=[],quizIdx=0,quizOK=0,quizBad=0,quizStreak=0,quizMissed=[],quizHistory=[],quizViewIdx=0,quizHardMode=false;
function esc(s){return String(s).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/'/g,'&#39;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
function toggleDark(){var d=document.documentElement.classList.toggle('dark');localStorage.setItem('cr_dark',d?'1':'0');document.getElementById('dark-toggle').textContent=d?'☀️':'🌙';}
(function(){if(localStorage.getItem('cr_dark')==='1'){document.documentElement.classList.add('dark');var b=document.getElementById('dark-toggle');if(b)b.textContent='☀️';}})();
function showScreen(id){document.querySelectorAll('.screen').forEach(function(s){s.classList.remove('active');});document.getElementById(id).classList.add('active');window.scrollTo(0,0);if(id==='s-pick'){var ii=document.getElementById('inline-search-input');if(ii&&ii.value){ii.value='';runInlineSearch();}}if(id==='s-pick')renderFdWheels();if(id==='s-hub')renderFdHubWheel();if(id==='s-main')renderFdSetupWheel();}

// ═══════════════════════════════════
// SEARCH
// ═══════════════════════════════════
function openSearch(){var ov=document.getElementById('search-overlay');if(!ov)return;ov.classList.add('open');var i=document.getElementById('search-input');if(i){i.value='';setTimeout(function(){i.focus();},50);}renderSearchEmpty();}
function closeSearch(){var ov=document.getElementById('search-overlay');if(ov)ov.classList.remove('open');}
function searchKeyHandler(e){if(e.key==='Escape'){closeSearch();return;}if(e.key==='Enter'){var f=document.querySelector('.search-result');if(f)f.click();}}
function renderSearchEmpty(){var o=document.getElementById('search-results');if(o)o.innerHTML='<div class="search-empty">Start typing to search all four units.</div>';}
function escRe(s){return s.replace(/[.*+?^${}()|[\]\\]/g,'\\$&');}
function escHtml(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
// Strip diacritics so e.g. searching "Dubcek" or "Rakosi" matches "Dubček" / "Rákosi".
function normSearch(s){return (s||'').toString().toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'');}
function highlightMatch(text,q){
  var safe=escHtml(text);
  if(!q)return safe;
  var normT=normSearch(text), normQ=normSearch(q);
  if(!normQ)return safe;
  var positions=[], i=0;
  while(true){
    var idx=normT.indexOf(normQ,i);
    if(idx===-1)break;
    positions.push([idx,idx+normQ.length]);
    i=idx+normQ.length;
  }
  if(!positions.length)return safe;
  var out='', last=0;
  for(var p=0;p<positions.length;p++){
    var start=positions[p][0], end=positions[p][1];
    out+=escHtml(text.slice(last,start));
    out+='<mark>'+escHtml(text.slice(start,end))+'</mark>';
    last=end;
  }
  out+=escHtml(text.slice(last));
  return out;
}
function snippet(text,q,len){
  if(!len)len=160;
  if(!text)return '';
  var normT=normSearch(text), normQ=normSearch(q);
  var i=normT.indexOf(normQ);
  if(i===-1)return text.length>len?text.slice(0,len)+'…':text;
  var start=Math.max(0,i-40);
  var end=Math.min(text.length,i+normQ.length+len-40);
  var out=text.slice(start,end);
  if(start>0)out='…'+out;
  if(end<text.length)out=out+'…';
  return out;
}
function cardAllFacts(card){if(card.subheadings&&card.subheadings.length)return card.subheadings.reduce(function(acc,s){return acc.concat(s.facts||[]);},[]);return card.facts||[];}
function searchKC(query){
  var q=normSearch(query.trim());
  if(!q||q.length<2||!KC.length)return [];
  var results=[];
  for(var i=0;i<KC.length;i++){
    var card=KC[i];
    var where=null,snip=null,rank=99;
    if(card.heading&&normSearch(card.heading).indexOf(q)!==-1){
      where='in title';rank=0;
      snip=card.summary||cardAllFacts(card)[0]||'';
    } else {
      var hint=(card.hints||[]).filter(function(h){return normSearch(h).indexOf(q)!==-1;})[0];
      if(hint){
        where='keyword: '+hint;rank=1;
        var fm=cardAllFacts(card).filter(function(f){return normSearch(f).indexOf(q)!==-1;})[0];
        snip=fm||card.summary||cardAllFacts(card)[0]||'';
      } else if(card.summary&&normSearch(card.summary).indexOf(q)!==-1){
        where='in summary';rank=2;snip=card.summary;
      } else {
        var fm2=cardAllFacts(card).filter(function(f){return normSearch(f).indexOf(q)!==-1;})[0];
        if(fm2){where='in detail';rank=3;snip=fm2;}
      }
    }
    if(where!==null)results.push({card:card,idx:i,where:where,snip:snip,rank:rank});
  }
  results.sort(function(a,b){return a.rank-b.rank;});
  return results.slice(0,25);
}
function runSearch(){
  var input=document.getElementById('search-input');
  var out=document.getElementById('search-results');
  if(!input||!out)return;
  var q=input.value.trim();
  if(q.length<2){renderSearchEmpty();return;}
  if(!KC.length){out.innerHTML='<div class="search-empty">⏳ Loading data… try again in a moment.</div>';return;}
  var results=searchKC(q);
  if(!results.length){out.innerHTML='<div class="search-empty">No matches for <strong>'+escHtml(q)+'</strong>.<br><span style="font-size:.75rem;opacity:.8">Try a shorter or different term.</span></div>';return;}
  var html='<div class="search-count">'+results.length+' result'+(results.length===1?'':'s')+'</div>';
  html+=results.map(function(r){
    var c=r.card;
    var unit=c.section;
    var u=UNITS[unit];
    var unitLabel=u?u.short:unit;
    var headingHtml=highlightMatch(c.heading,q);
    var snippetHtml=r.snip?highlightMatch(snippet(r.snip,q),q):'';
    var flags='';
    if(c.isDepthStudy)flags+='<span class="tag t-ds">🔑</span>';
    if(c.isFactor)flags+='<span class="tag t-fac">⚙️</span>';
    if(c.isObstacle)flags+='<span class="tag t-obs">🛑</span>';
    if(c.isTurningPoint)flags+='<span class="tag t-tp">🔄</span>';
    return '<div class="search-result" data-unit="'+unit+'" data-idx="'+r.idx+'">'+
      '<div class="search-result-meta">'+
        '<span class="tag t-'+unit+'">'+escHtml(unitLabel)+'</span>'+flags+
      '</div>'+
      '<div class="search-result-heading">'+headingHtml+'</div>'+
      (snippetHtml?'<div class="search-result-snippet">'+snippetHtml+'</div>':'')+
      '<div class="search-result-where">Match '+escHtml(r.where)+'</div>'+
    '</div>';
  }).join('');
  out.innerHTML=html;
  out.querySelectorAll('.search-result').forEach(function(el){
    el.addEventListener('click',function(){
      goToSearchResult(el.dataset.unit,parseInt(el.dataset.idx,10));
    });
  });
}
function goToSearchResult(unit,idx){
  closeSearch();
  pickUnit(unit);
  enterMode('knowledge');
  kPeriodIdx=idx;
  var card=KC[idx];
  if(card){
    var pSel=document.getElementById('k-period');
    var dsSel=document.getElementById('k-ds');
    if(card.isDepthStudy){
      if(dsSel)dsSel.value=idx;
      if(pSel)pSel.value='';
    } else {
      if(pSel)pSel.value=idx;
      if(dsSel)dsSel.value='';
    }
    renderKCard(idx);
  }
}

// Inline search bar (on s-pick) — shares searchKC and goToSearchResult with the overlay
function runInlineSearch(){
  var input=document.getElementById('inline-search-input');
  var out=document.getElementById('inline-search-results');
  var clear=document.getElementById('inline-search-clear');
  if(!input||!out)return;
  var q=input.value.trim();
  if(clear)clear.classList.toggle('show',q.length>0);
  if(q.length<2){out.innerHTML='';return;}
  if(!KC.length){out.innerHTML='<div class="search-empty">⏳ Loading data… try again in a moment.</div>';return;}
  var results=searchKC(q).slice(0,10);
  if(!results.length){out.innerHTML='<div class="search-empty">No matches for <strong>'+escHtml(q)+'</strong>.</div>';return;}
  var html='<div class="search-count">'+results.length+' result'+(results.length===1?'':'s')+'</div>';
  html+=results.map(function(r){
    var c=r.card;
    var unit=c.section;
    var u=UNITS[unit];
    var unitLabel=u?u.short:unit;
    var headingHtml=highlightMatch(c.heading,q);
    var snippetHtml=r.snip?highlightMatch(snippet(r.snip,q),q):'';
    var flags='';
    if(c.isDepthStudy)flags+='<span class="tag t-ds">🔑</span>';
    if(c.isFactor)flags+='<span class="tag t-fac">⚙️</span>';
    if(c.isObstacle)flags+='<span class="tag t-obs">🛑</span>';
    if(c.isTurningPoint)flags+='<span class="tag t-tp">🔄</span>';
    return '<div class="search-result" data-unit="'+unit+'" data-idx="'+r.idx+'">'+
      '<div class="search-result-meta">'+
        '<span class="tag t-'+unit+'">'+escHtml(unitLabel)+'</span>'+flags+
      '</div>'+
      '<div class="search-result-heading">'+headingHtml+'</div>'+
      (snippetHtml?'<div class="search-result-snippet">'+snippetHtml+'</div>':'')+
      '<div class="search-result-where">Match '+escHtml(r.where)+'</div>'+
    '</div>';
  }).join('');
  out.innerHTML=html;
  out.querySelectorAll('.search-result').forEach(function(el){
    el.addEventListener('click',function(){
      goToSearchResult(el.dataset.unit,parseInt(el.dataset.idx,10));
    });
  });
}
function clearInlineSearch(){
  var input=document.getElementById('inline-search-input');
  if(input){input.value='';input.focus();}
  runInlineSearch();
}
function inlineSearchKey(e){
  if(e.key==='Escape'){clearInlineSearch();return;}
  if(e.key==='Enter'){
    var f=document.querySelector('#inline-search-results .search-result');
    if(f)f.click();
  }
}
function pickUnit(unit){currentUnit=unit;var u=UNITS[unit];['hub-badge','main-badge'].forEach(function(id){var el=document.getElementById(id);if(el){el.textContent=u.short;el.className='section-badge bg-'+unit;}});var pb=document.getElementById('fd-primary-btn');if(pb)pb.style.borderLeftColor=u.colour;['knowledge','dates','exam'].forEach(function(m){var b=document.getElementById('hub-btn-'+m);if(b)b.style.borderLeftColor=u.colour;});var eb=document.getElementById('exam-btn-essay');if(eb){eb.style.borderColor=u.colour;eb.style.color=u.colour;}buildPeriodDropdown();rebuildEraUI();showScreen('s-hub');renderFdHubWheel();var hpb=document.getElementById('hub-pinned-btn');if(hpb){var out=fdGetOutstanding().filter(function(k){return FD.find(function(c){return fdKey(c)===k&&c.section===unit;});});hpb.style.display=out.length>0?'block':'none';hpb.textContent='📌 Review '+out.length+' pinned card'+(out.length>1?'s':'');}}
function enterMode(mode){var titles={knowledge:'Revision Guide',flashcard:'Flashcard Mode',dates:'Key Dates Quiz',exam:'Exam Practice'};document.getElementById('mode-title').textContent=titles[mode]||'';['knowledge','flashcard','dates','exam'].forEach(function(m){document.getElementById('mode-'+m).style.display=m===mode?'block':'none';});if(mode==='flashcard')fdSetup();if(mode==='dates'){datesShowSetup();applyDatesHardBtn();}if(mode==='exam')showExamPick();showScreen('s-main');}
function rand(arr){return arr[Math.floor(Math.random()*arr.length)];}
function shuffle(a){var b=a.slice();for(var i=b.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=b[i];b[i]=b[j];b[j]=t;}return b;}
function tog(id,btn,a,b){var el=document.getElementById(id);if(!el)return;var open=el.classList.toggle('open');if(btn)btn.textContent=open?(b||'Hide'):(a||'Show');}
function buildPeriodDropdown(){
  var sel=document.getElementById('k-period');
  var dsSel=document.getElementById('k-ds');
  var dsRow=document.getElementById('k-ds-row');
  // Filter by current unit
  var unitKC=KC.filter(function(c){return c.section===currentUnit;});
  var dsCards=unitKC.filter(function(c){return c.isDepthStudy;});
  var factorCards=unitKC.filter(function(c){return c.isFactor;});
  var obstacleCards=unitKC.filter(function(c){return c.isObstacle;});
  sel.innerHTML='<option value="">-- select a card --</option>';
  // Era and TP cards in JSON order — TPs appear inline with era cards
  KC.forEach(function(c,i){
    if(c.section!==currentUnit)return;
    if(!c.isDepthStudy&&!c.isFactor&&!c.isObstacle){
      var o=document.createElement('option');o.value=i;
      o.textContent=(c.isTurningPoint?'🔄 ':'')+c.heading;
      sel.appendChild(o);
    }
  });
  // Factors as a grouped section
  if(factorCards.length){
    var grp=document.createElement('optgroup');grp.label='⚙️ Factors';
    KC.forEach(function(c,i){
      if(c.section===currentUnit&&c.isFactor){
        var o=document.createElement('option');o.value=i;o.textContent='⚙️ '+c.heading;grp.appendChild(o);
      }
    });
    sel.appendChild(grp);
  }
  // Obstacles as a grouped section
  if(obstacleCards.length){
    var grp2=document.createElement('optgroup');grp2.label='🛑 Obstacles';
    KC.forEach(function(c,i){
      if(c.section===currentUnit&&c.isObstacle){
        var o=document.createElement('option');o.value=i;o.textContent='🛑 '+c.heading;grp2.appendChild(o);
      }
    });
    sel.appendChild(grp2);
  }
  // DS dropdown
  if(dsCards.length){
    dsRow.style.display='';
    dsSel.innerHTML='<option value="">-- select a depth study debate --</option>';
    KC.forEach(function(c,i){
      if(c.section===currentUnit&&c.isDepthStudy){
        var o=document.createElement('option');o.value=i;o.textContent=c.heading;dsSel.appendChild(o);
      }
    });
  } else {
    dsRow.style.display='none';
  }
  kPeriodIdx=0;document.getElementById('k-out').innerHTML='<div class="empty">Select a card above to begin.</div>';
}
function jumpToDs(){var sel=document.getElementById('k-ds');if(sel.value==='')return;document.getElementById('k-period').value='';kPeriodIdx=parseInt(sel.value);renderKCard(kPeriodIdx);}
function jumpToPeriod(){var sel=document.getElementById('k-period');if(sel.value==='')return;document.getElementById('k-ds').value='';kPeriodIdx=parseInt(sel.value);renderKCard(kPeriodIdx);}
function stepPeriod(dir){if(!KC.length)return;var eraIdxs=KC.map(function(c,i){return(!c.isDepthStudy&&!c.isFactor&&!c.isObstacle&&!c.isTurningPoint)?i:-1;}).filter(function(i){return i>=0;});var cur=eraIdxs.indexOf(kPeriodIdx);if(cur===-1)cur=0;var next=eraIdxs[(cur+dir+eraIdxs.length)%eraIdxs.length];kPeriodIdx=next;document.getElementById('k-period').value=next;document.getElementById('k-ds').value='';renderKCard(kPeriodIdx);}
function renderKCard(idx){var card=KC[idx];if(!card){document.getElementById('k-out').innerHTML='<div class="empty">Content coming soon.</div>';return;}var u=UNITS[currentUnit],badges='';if(card.isDepthStudy)badges+='<span class="tag t-ds">🔑 Depth Study</span>';if(card.isObstacle)badges+='<span class="tag t-obs">🛑 Obstacle</span>';if(card.isFactor)badges+='<span class="tag t-fac">⚙️ Factor</span>';if(card.isTurningPoint)badges+='<span class="tag t-tp">🔄 Turning Point</span>';var sub=(function(){
  var subs=card.subheadings||[];
  var html='';
  var lastGroup=null;
  subs.forEach(function(s){
    var grp=s.group&&s.group!=='NONE'?s.group:null;
    if(grp&&grp!==lastGroup){
      html+='<div class="kc-group">'+grp+'</div>';
      lastGroup=grp;
    }
    if(grp){
      html+='<div class="kc-sublabel">'+s.label+'</div>';
    } else {
      html+='<div class="kc-sub">'+s.label+'</div>';
    }
    html+='<ul>'+(s.facts||[]).map(function(f){return '<li>'+f+'</li>';}).join('')+'</ul>';
  });
  return html;
})();document.getElementById('k-out').innerHTML='<div class="card"><div class="stripe s-'+currentUnit+'"></div><div class="inner"><div class="meta"><span class="tag t-'+currentUnit+'">'+u.short+'</span>'+badges+'</div><div class="card-heading">'+card.heading+'</div>'+(card.summary?'<p class="kc-summary">'+card.summary+'</p>':'')+(card.factorKey?'<div class="factor-key">'+card.factorKey+'</div>':'')+sub+'</div></div>';}
