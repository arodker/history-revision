function buildKPool(){
  const unit=document.getElementById('k-unit').value;
  let all=KC.filter(c=>c.reign===currentReign);
  const units=R[currentReign].units;
  all.sort((a,b)=>{const ui=units.indexOf(a.unit),vi=units.indexOf(b.unit);if(ui!==vi)return ui-vi;return KC.indexOf(a)-KC.indexOf(b);});
  if(unit!=='all')all=all.filter(c=>c.unit===unit);
