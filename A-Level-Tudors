<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mr Rodker's Revision Hub – A Level Tudors</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Source+Serif+4:opsz,wght@8..60,300;8..60,400;8..60,600&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Source Serif 4',Georgia,serif;background:#faf9f6;color:#1c1a16;min-height:100vh}
.app{max-width:740px;margin:0 auto;padding:1.5rem 1rem 4rem}
h1{font-family:'Playfair Display',serif;font-size:1.65rem;font-weight:600;letter-spacing:-.01em;margin-bottom:.15rem}
.subtitle{font-size:.79rem;color:#7a7060;margin-bottom:1.75rem;letter-spacing:.04em;text-transform:uppercase}
.screen{display:none}.screen.active{display:block}
.reign-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin-bottom:1rem}
.reign-btn{padding:1.3rem .85rem;border:1.5px solid transparent;border-radius:14px;cursor:pointer;font-family:'Playfair Display',serif;font-weight:400;font-size:.93rem;text-align:left;transition:all .15s;line-height:1.3}
.reign-btn .rlabel{font-family:'Source Serif 4',serif;font-size:.67rem;font-weight:700;opacity:.7;display:block;margin-bottom:.35rem;text-transform:uppercase;letter-spacing:.06em}
.rb-edward{background:#EEF3FB;color:#1B4B9A;border-color:#6B9DE8}
.rb-mary{background:#FBF0EE;color:#9A1B1B;border-color:#E87A6B}
.rb-elizabeth{background:#EEF8F2;color:#1B6B3A;border-color:#6BE8A0}
.rb-edward:hover{background:#dce8f7}.rb-mary:hover{background:#f7dede}.rb-elizabeth:hover{background:#d9f2e5}
.home-extra{margin-top:1.25rem;padding-top:1.25rem;border-top:1px solid #e4e3dc}
.home-extra-label{font-size:.7rem;font-weight:700;color:#7a7060;text-transform:uppercase;letter-spacing:.06em;margin-bottom:.6rem}
.mode-header{display:flex;align-items:center;gap:10px;margin-bottom:1.25rem}
.back-btn{padding:6px 12px;font-size:.78rem;font-weight:700;border:1px solid #ddddd4;border-radius:8px;background:#fff;color:#7a7060;cursor:pointer;font-family:inherit}
.back-btn:hover{background:#f4f3ef}
.reign-badge{font-size:.78rem;font-weight:700;padding:5px 12px;border-radius:20px;font-family:'Source Serif 4',serif}
.bg-edward{background:#EEF3FB;color:#1B4B9A}.bg-mary{background:#FBF0EE;color:#9A1B1B}.bg-elizabeth{background:#EEF8F2;color:#1B6B3A}
.mode-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin-bottom:1.25rem}
.mode-btn{padding:1.15rem .75rem;border:1.5px solid #ddddd4;border-radius:12px;cursor:pointer;font-family:inherit;font-size:.82rem;font-weight:700;text-align:center;background:#fff;color:#1c1a16;transition:all .15s}
.mode-btn .icon{font-size:1.35rem;display:block;margin-bottom:.4rem}
.mode-btn:hover{border-color:#aaa9a0;background:#faf9f6}
.mode-btn.sel{border-color:#1c1a16;background:#1c1a16;color:#fff}
.filter-row{display:flex;gap:8px;margin-bottom:1rem;flex-wrap:wrap}
select{padding:8px 10px;font-size:.8rem;border:1px solid #ddddd4;border-radius:8px;background:#fff;color:#1c1a16;cursor:pointer;flex:1;min-width:140px;font-family:inherit}
.btn-go{width:100%;padding:12px;font-size:.92rem;font-weight:700;border:none;border-radius:10px;cursor:pointer;margin-bottom:1.2rem;transition:opacity .15s;color:#fff;font-family:inherit}
.btn-go:hover{opacity:.9}
.go-edward{background:#2A6BC8}.go-mary{background:#C82A2A}.go-elizabeth{background:#2A8C4A}.go-dark{background:#1c1a16}
.card{background:#fff;border:1px solid #e4e3dc;border-radius:14px;padding:1.25rem;margin-bottom:.75rem;position:relative;overflow:hidden}
.stripe{position:absolute;left:0;top:0;bottom:0;width:4px;border-radius:4px 0 0 4px}
.s-edward{background:#6B9DE8}.s-mary{background:#E87A6B}.s-elizabeth{background:#6BE8A0}
.inner{padding-left:.5rem}
.meta{display:flex;flex-wrap:wrap;gap:5px;margin-bottom:.6rem}
.tag{font-size:.68rem;font-weight:700;padding:3px 9px;border-radius:20px;letter-spacing:.03em}
.t-grey{background:#eeede5;color:#6a6860}
.t-edward{background:#EEF3FB;color:#1B4B9A}.t-mary{background:#FBF0EE;color:#9A1B1B}.t-elizabeth{background:#EEF8F2;color:#1B6B3A}
.card-heading{font-family:'Playfair Display',serif;font-size:1.05rem;font-weight:400;margin-bottom:.5rem;line-height:1.35}
.btn-row{display:flex;gap:8px;flex-wrap:wrap;margin-top:.9rem}
.btn-sm{padding:7px 13px;font-size:.78rem;font-weight:700;border:1px solid #ddddd4;border-radius:8px;background:#fff;color:#1c1a16;cursor:pointer;transition:background .12s;font-family:inherit}
.btn-sm:hover{background:#f4f3ef}
.reveal{display:none;border-top:1px solid #eeede5;margin-top:.9rem;padding-top:.9rem}
.reveal.open{display:block}
.reveal ul{padding-left:1.1rem}
.reveal li{font-size:.84rem;line-height:1.65;color:#1c1a16;margin-bottom:.2rem}
.hint-chips{display:flex;flex-wrap:wrap;gap:5px;padding:.4rem 0}
.empty{padding:2rem;text-align:center;color:#aaa8a0;font-size:.85rem;border:1px dashed #ddddd4;border-radius:12px;font-style:italic}
.quiz-prog{height:3px;background:#e4e3dc;border-radius:2px;margin-bottom:1rem;overflow:hidden}
.quiz-fill{height:100%;border-radius:2px;transition:width .3s}
.fill-edward{background:#2A6BC8}.fill-mary{background:#C82A2A}.fill-elizabeth{background:#2A8C4A}
.quiz-hdr{display:flex;justify-content:space-between;align-items:center;margin-bottom:.75rem}
.quiz-hdr-l{font-size:.78rem;color:#7a7060}
.sc-row{display:flex;gap:6px}
.sc{font-size:.78rem;font-weight:700;padding:4px 10px;border-radius:20px}
.sc-c{background:#e8f5e0;color:#2E6B0E}.sc-w{background:#fce8e8;color:#9A1B1B}
.quiz-card{background:#fff;border:1px solid #e4e3dc;border-radius:14px;padding:1.5rem;text-align:center;margin-bottom:.75rem}
.quiz-date{font-family:'Playfair Display',serif;font-size:2.8rem;font-weight:400;margin-bottom:.3rem;letter-spacing:-.02em}
.quiz-prompt{font-size:.8rem;color:#7a7060;margin-bottom:1.2rem}
.opts{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.opt{padding:10px 8px;font-size:.79rem;font-weight:600;border:1.5px solid #ddddd4;border-radius:9px;background:#fff;color:#1c1a16;cursor:pointer;text-align:left;line-height:1.4;transition:all .15s;font-family:inherit}
.opt:hover:not(:disabled){background:#f4f3ef;border-color:#aaa}
.opt:disabled{cursor:default}
.opt.correct{background:#e8f5e0!important;border-color:#2E6B0E!important;color:#2E6B0E!important}
.opt.wrong{background:#fce8e8!important;border-color:#9A1B1B!important;color:#9A1B1B!important}
.opt.show-c{background:#e8f5e0!important;border-color:#2E6B0E!important;color:#2E6B0E!important;opacity:.8}
.quiz-fb{font-size:.84rem;font-weight:700;padding:8px;border-radius:8px;margin-top:.75rem;display:none;text-align:center}
.fb-c{background:#e8f5e0;color:#2E6B0E}.fb-w{background:#fce8e8;color:#9A1B1B}
.quiz-end{text-align:center;padding:2rem 1rem}
.end-score{font-family:'Playfair Display',serif;font-size:3.5rem;font-weight:400}
.end-sub{font-size:.88rem;color:#7a7060;margin:.3rem 0 1.2rem;font-style:italic}
.end-grade{font-size:.88rem;font-weight:700;padding:7px 18px;border-radius:20px;display:inline-block;margin-bottom:1.2rem}
.grade-a{background:#e8f5e0;color:#2E6B0E}.grade-b{background:#fff4df;color:#7a4e00}.grade-c{background:#fce8e8;color:#9A1B1B}
.rq-section-label{font-size:.7rem;font-weight:700;color:#7a7060;text-transform:uppercase;letter-spacing:.06em;margin-bottom:.6rem}
.rq-pills{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:.9rem}
.rq-pill{padding:6px 12px;font-size:.76rem;font-weight:700;border:1.5px solid #ddddd4;border-radius:20px;cursor:pointer;background:#fff;color:#7a7060;font-family:inherit;transition:all .15s}
.rq-pill.on-edward{background:#EEF3FB;color:#1B4B9A;border-color:#6B9DE8}
.rq-pill.on-mary{background:#FBF0EE;color:#9A1B1B;border-color:#E87A6B}
.rq-pill.on-elizabeth{background:#EEF8F2;color:#1B6B3A;border-color:#6BE8A0}
.rq-pill.on{background:#1c1a16;color:#fff;border-color:#1c1a16}
.rq-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:1rem}
.rq-card{background:#fff;border:1.5px solid #e4e3dc;border-radius:12px;padding:.85rem;cursor:pointer;min-height:90px;display:flex;flex-direction:column;justify-content:space-between;transition:border-color .15s}
.rq-card:hover{border-color:#aaa}
.rq-card.revealed{border-color:#2E6B0E;cursor:default}
.rq-q{font-size:.77rem;line-height:1.5;color:#1c1a16;font-weight:600}
.rq-a{display:none;margin-top:.5rem;padding:.4rem .5rem;background:#e8f5e0;border-radius:7px;font-size:.77rem;font-weight:700;color:#2E6B0E;line-height:1.4}
.rq-card.revealed .rq-a{display:block}
.rq-tap{font-size:.66rem;color:#ccc;margin-top:.4rem}
.rq-card.revealed .rq-tap{display:none}
.rq-dot{width:7px;height:7px;border-radius:50%;display:inline-block;margin-right:4px;flex-shrink:0;vertical-align:middle}
.dot-edward{background:#6B9DE8}.dot-mary{background:#E87A6B}.dot-elizabeth{background:#6BE8A0}
.rq-btn-row{display:flex;gap:8px;flex-wrap:wrap}
.rq-btn-row .btn-sm{background:#eeede5;color:#1c1a16;border-color:#ddddd4}
.prog-wrap{margin-bottom:.75rem;display:none}
.prog-text{font-size:.73rem;color:#7a7060;margin-bottom:4px}
.prog-bg{background:#e5e4dc;border-radius:99px;height:5px}
.prog-fill{height:5px;border-radius:99px;background:#2A8C4A;transition:width .3s}
.flag-bar{display:none;gap:8px;align-items:center;margin-bottom:.75rem}
.exam-route-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:1.25rem}
.exam-route-btn{padding:1.3rem 1rem;border:1.5px solid #ddddd4;border-radius:12px;cursor:pointer;font-family:inherit;font-size:.85rem;font-weight:700;text-align:left;background:#fff;color:#1c1a16;transition:all .15s;line-height:1.4}
.exam-route-btn .er-label{font-size:.67rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;display:block;margin-bottom:.3rem;opacity:.6}
.exam-route-btn:hover{border-color:#aaa9a0;background:#faf9f6}
.exam-route-btn.disabled{opacity:.35;cursor:default;pointer-events:none}
.erb-source{border-color:#B87020;color:#7a4e00}.erb-source:hover{background:#fffbf5}
.erb-essay{border-color:#1B6B3A;color:#1B6B3A}.erb-essay:hover{background:#f0faf4}
.source-set-card{background:#fff;border:1px solid #e4e3dc;border-radius:14px;overflow:hidden;margin-bottom:.75rem}
.source-set-header{padding:1rem 1.25rem;border-bottom:1px solid #e4e3dc;background:#faf9f6}
.source-set-q{font-family:'Playfair Display',serif;font-size:1rem;font-weight:600;line-height:1.4;color:#1c1a16;margin-bottom:.5rem}
.source-set-meta{font-size:.74rem;color:#7a7060}
.source-body{padding:1rem 1.25rem}
.source-item{border:1px solid #e4e3dc;border-radius:9px;padding:.85rem 1rem;margin-bottom:.75rem;background:#fff}
.source-item-hdr{font-size:.76rem;font-weight:700;color:#1c1a16;margin-bottom:.2rem}
.source-item-prov{font-size:.72rem;color:#7a7060;margin-bottom:.55rem;font-style:italic}
.source-item-text{font-size:.82rem;line-height:1.7;color:#1c1a16}
.approach-box{background:#faf9f6;border:1px solid #e4e3dc;border-radius:9px;padding:.85rem 1rem;margin-top:.75rem;display:none}
.approach-box.open{display:block}
.approach-title{font-size:.68rem;font-weight:700;color:#7a7060;text-transform:uppercase;letter-spacing:.06em;margin-bottom:.5rem}
.approach-list{list-style:none;padding:0}
.approach-list li{font-size:.8rem;line-height:1.6;color:#1c1a16;padding:.25rem 0;border-bottom:1px solid #e4e3dc;display:flex;gap:.5rem}
.approach-list li:last-child{border-bottom:none}
.approach-list li::before{content:'→';color:#7a7060;flex-shrink:0;font-weight:700}
.essay-card{background:#fff;border:1px solid #e4e3dc;border-radius:14px;padding:1.25rem;margin-bottom:.75rem}
.essay-q{font-family:'Playfair Display',serif;font-size:1.05rem;font-weight:400;line-height:1.45;margin-bottom:.6rem}
.essay-meta{font-size:.74rem;color:#7a7060;margin-bottom:.75rem}
.essay-structure{background:#EEF8F2;border-radius:8px;padding:.85rem 1rem;margin-top:.75rem;display:none}
.essay-structure.open{display:block}
.essay-structure-title{font-size:.68rem;font-weight:700;color:#1B6B3A;text-transform:uppercase;letter-spacing:.06em;margin-bottom:.6rem}
.essay-structure table{width:100%;border-collapse:collapse;font-size:.8rem}
.essay-structure td{padding:.35rem .5rem;border-bottom:1px solid #d4edde;vertical-align:top}
.essay-structure td:first-child{font-weight:700;color:#1B6B3A;white-space:nowrap;padding-right:.75rem}
.essay-structure tr:last-child td{border-bottom:none}
.checklist-tag{font-size:.67rem;font-weight:700;padding:2px 7px;border-radius:5px;background:#FEF9E7;color:#7a4e00;border:1px solid #F0B429;display:inline-block;margin-bottom:.5rem}
</style>
</head>
<body>
<div class="app">
<div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:.2rem">
  <h1>A Level History</h1>
  <a href="index.html" style="font-size:.74rem;font-weight:700;padding:6px 12px;border:1px solid #ddddd4;border-radius:8px;background:#fff;color:#7a7060;text-decoration:none;font-family:inherit">← Hub</a>
</div>
<p class="subtitle">Mr Rodker's Revision Hub &mdash; OCR Y107 · England 1547–1603</p>

<div class="screen active" id="s-pick">
  <p style="font-size:.85rem;color:#7a7060;margin-bottom:.9rem;font-style:italic">Choose a reign to revise:</p>
  <div class="reign-grid">
    <button class="reign-btn rb-edward" onclick="pickReign('edward')"><span class="rlabel">1547–53</span>👑 Edward VI</button>
    <button class="reign-btn rb-mary" onclick="pickReign('mary')"><span class="rlabel">1553–58</span>🔥 Mary I</button>
    <button class="reign-btn rb-elizabeth" onclick="pickReign('elizabeth')"><span class="rlabel">1558–1603</span>⚜️ Elizabeth I</button>
  </div>
  <div class="home-extra">
    <p class="home-extra-label">Or try Rapid Fire — all reigns mixed:</p>
    <button class="btn-go go-dark" onclick="showRapidSetup()">⚡ Rapid Fire</button>
    <button class="btn-go" id="home-flag-btn" style="background:#eeede5;color:#1c1a16;display:none;margin-bottom:0" onclick="goToFlagged()">🚩 Review flagged cards (<span id="home-flag-num">0</span>)</button>
  </div>
</div>

<div class="screen" id="s-main">
  <div class="mode-header">
    <button class="back-btn" onclick="goBack()">🏠 Home</button>
    <span class="reign-badge" id="reign-badge"></span>
  </div>
  <div class="mode-grid">
    <button class="mode-btn" id="mb-knowledge" onclick="setMode('knowledge')"><span class="icon">🧠</span>Knowledge Builder</button>
    <button class="mode-btn" id="mb-dates" onclick="setMode('dates')"><span class="icon">📅</span>Key Dates</button>
    <button class="mode-btn" id="mb-exam" onclick="setMode('exam')"><span class="icon">✏️</span>Exam Practice</button>
  </div>

  <div id="mode-knowledge" style="display:none">
    <div class="filter-row">
      <select id="k-unit" onchange="onUnitChange()"><option value="all">All units</option></select>
      <select id="k-card" onchange="jumpToCard()"></select>
    </div>
    <button class="btn-go" id="k-go" onclick="drawRandomCard()">🔀 Random card</button>
    <div style="display:flex;gap:8px;margin-bottom:.75rem;margin-top:-.5rem">
      <button class="btn-sm" onclick="stepCard(-1)" style="flex:1;padding:9px;font-size:.84rem;font-weight:700;text-align:center">← Prev</button>
      <span id="k-card-num" style="flex:0 0 auto;align-self:center;font-size:.76rem;color:#7a7060;white-space:nowrap;min-width:50px;text-align:center"></span>
      <button class="btn-sm" onclick="stepCard(1)" style="flex:1;padding:9px;font-size:.84rem;font-weight:700;text-align:center">Next →</button>
    </div>
    <div class="prog-wrap" id="k-prog-wrap">
      <div class="prog-text"><span id="k-prog-text"></span></div>
      <div class="prog-bg"><div class="prog-fill" id="k-prog-bar"></div></div>
    </div>
    <div class="flag-bar" id="k-flag-bar">
      <span style="font-size:.8rem;color:#7a7060">🚩 <span id="k-flag-num">0</span> flagged</span>
      <button class="btn-sm" onclick="showFlaggedScreen()">Review flagged</button>
      <button class="btn-sm" onclick="clearFlagged()">Clear</button>
    </div>
    <div id="k-out"></div>
  </div>

  <div id="mode-dates" style="display:none">
    <button class="btn-go" id="d-go" onclick="startDateQuiz()">📅 Start key dates quiz</button>
    <div id="d-out"></div>
  </div>

  <div id="mode-exam" style="display:none">
    <div id="exam-route-pick">
      <p style="font-size:.84rem;color:#7a7060;margin-bottom:.9rem;font-style:italic" id="exam-route-intro"></p>
      <div class="exam-route-grid" id="exam-route-grid"></div>
    </div>
    <div id="exam-source-mode" style="display:none">
      <div style="display:flex;gap:8px;margin-bottom:1rem;flex-wrap:wrap">
        <button class="btn-go" id="source-go" style="margin-bottom:0;flex:1" onclick="drawSourceSet()">🔀 New source set</button>
        <button class="btn-sm" onclick="stepSourceSet(-1)" style="padding:10px 14px">←</button>
        <button class="btn-sm" onclick="stepSourceSet(1)" style="padding:10px 14px">→</button>
      </div>
      <div id="source-out"></div>
      <button class="btn-sm" style="margin-top:.5rem" onclick="backToExamRoutes()">← Back</button>
    </div>
    <div id="exam-essay-mode" style="display:none">
      <button class="btn-go go-elizabeth" onclick="drawEssayQ()">🔀 Random 20-marker</button>
      <div id="essay-out"></div>
      <button class="btn-sm" style="margin-top:.5rem" onclick="backToExamRoutes()">← Back</button>
    </div>
  </div>
</div>

<div class="screen" id="s-rapid">
  <div class="mode-header">
    <button class="back-btn" onclick="showScreen('s-pick')">← Home</button>
    <span style="font-size:.84rem;font-weight:700;color:#5a584e">⚡ Rapid Fire</span>
  </div>
  <div id="rq-setup">
    <p class="rq-section-label">Which reigns?</p>
    <div class="rq-pills">
      <button class="rq-pill on-edward" id="rqp-edward" onclick="toggleRQPill('edward')">👑 Edward VI</button>
      <button class="rq-pill on-mary" id="rqp-mary" onclick="toggleRQPill('mary')">🔥 Mary I</button>
      <button class="rq-pill on-elizabeth" id="rqp-elizabeth" onclick="toggleRQPill('elizabeth')">⚜️ Elizabeth I</button>
    </div>
    <p class="rq-section-label">Which topics?</p>
    <div class="rq-pills" id="rq-topic-pills"></div>
    <button class="btn-go go-dark" onclick="generateRQ()">⚡ Generate questions</button>
  </div>
  <div id="rq-out" style="display:none">
    <div class="rq-grid" id="rq-grid"></div>
    <div class="rq-btn-row">
      <button class="btn-sm" onclick="generateRQ()">🔄 New questions</button>
      <button class="btn-sm" onclick="revealAll()">👁 Reveal all</button>
      <button class="btn-sm" onclick="document.getElementById('rq-setup').style.display='block';document.getElementById('rq-out').style.display='none'">⚙️ Settings</button>
    </div>
  </div>
</div>

<div class="screen" id="s-flagged">
  <div class="mode-header">
    <button class="back-btn" onclick="showScreen('s-pick')">🏠 Home</button>
    <span style="font-size:.84rem;font-weight:700;color:#5a584e">🚩 Flagged for review</span>
  </div>
  <div id="flagged-out"></div>
</div>

</div>
<script>
const R={
  edward:{label:'Edward VI (1547–53)',badge:'bg-edward',go:'go-edward',fill:'fill-edward',
    units:['Unit 1 – Stability of the Monarchy','Unit 2 – Religious Change','Unit 3 – Rebellion and Unrest'],
    hasSource:true,hasEssay:false},
  mary:{label:'Mary I (1553–58)',badge:'bg-mary',go:'go-mary',fill:'fill-mary',
    units:['Unit 1 – Stability of the Monarchy','Unit 2 – Religious Change','Unit 3 – Rebellion and Unrest'],
    hasSource:true,hasEssay:false},
  elizabeth:{label:'Elizabeth I (1558–1603)',badge:'bg-elizabeth',go:'go-elizabeth',fill:'fill-elizabeth',
    units:['Unit 4 – Elizabeth I and Religion','Unit 5 – Government and Parliament','Unit 6 – Financial, Economic and Social Affairs','Unit 7 – Later Years 1588–1603'],
    hasSource:false,hasEssay:true}
};
let currentReign='elizabeth';

function pickReign(r){
  currentReign=r;
  const info=R[r];
  document.getElementById('reign-badge').textContent=info.label;
  document.getElementById('reign-badge').className='reign-badge '+info.badge;
  ['k-go','d-go'].forEach(id=>{const el=document.getElementById(id);if(el)el.className='btn-go '+info.go;});
  const sel=document.getElementById('k-unit');
